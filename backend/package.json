{
  "name": "multitenant-bff-api",
  "version": "1.0.0",
  "description": "Multi-tenant BFF and API backend with Fastify, Prisma, and PostgreSQL",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed-menus": "tsx prisma/seed-menu-items.ts",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset",
    "test": "tsx --test test/*.test.ts"
  },
  "keywords": [
    "fastify",
    "prisma",
    "postgresql",
    "multi-tenant",
    "bff",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "allowScripts": {
    "prisma": true,
    "@prisma/engines": true,
    "esbuild": true
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.2",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.5",
    "pg": "^8.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "pino-pretty": "^13.0.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
