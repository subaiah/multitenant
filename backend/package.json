{
  "name": "multitenant-api",
  "version": "1.0.0",
  "description": "Multi-tenant platform API (Fastify, Prisma, PostgreSQL)",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node -e \"require('fs').cpSync('src/generated', 'dist/generated', { recursive: true })\"",
    "start": "node dist/server.js",
    "worker": "tsx src/worker.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "platform:admin": "tsx src/cli/create-admin.ts",
    "test": "tsx --test test/*.test.ts",
    "prisma:generate": "prisma generate && prisma generate --config prisma.tenant.config.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:tenant": "prisma migrate dev --config prisma.tenant.config.ts && tsx src/cli/tenant-migrate.ts",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed-menus": "tsx prisma/seed-menu-items.ts",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset",
    "tenant:migrate": "tsx src/cli/tenant-migrate.ts",
    "tenant:baseline": "tsx prisma/tenant-baseline.ts",
    "secrets:encrypt": "tsx src/cli/encrypt-secrets.ts",
    "audit:archive": "tsx src/cli/audit.ts archive",
    "audit:verify": "tsx src/cli/audit.ts verify"
  },
  "keywords": [
    "fastify",
    "prisma",
    "postgresql",
    "multi-tenant",
    "bff",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "allowScripts": {
    "prisma": true,
    "@prisma/engines": true,
    "esbuild": true
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.2",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "nodemailer": "^10.1.2",
    "openid-client": "^6.8.8",
    "pg": "^8.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "pino-pretty": "^13.0.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
