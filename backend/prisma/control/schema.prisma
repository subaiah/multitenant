// Control plane: the platform's own data. Platform users, tenants and how
// to reach each tenant's data, the app catalogue, menus, support sessions.
// Nothing tenant-owned lives here; that's the tenant schema (prisma/tenant).
// Migrated once, against DATABASE_URL. Config: prisma.config.ts.

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/control"
}

datasource db {
  provider = "postgresql"
}

// A customer organization. Its users, roles and data live in the tenant plane.
model Tenant {
  id              String       @id @default(uuid())
  name            String
  slug            String       @unique
  plan            TenantPlan
  status          TenantStatus

  // Branding (read before sign-in)
  logoUrl         String?      @map("logo_url")
  primaryColor    String?      @default("#3b82f6") @map("primary_color")
  // The tenant's own web address (lib/domains.ts): proven by a DNS TXT
  // record before anything is served on it
  customDomain    String?      @unique @map("custom_domain")
  customDomainStatus     CustomDomainStatus? @map("custom_domain_status")
  customDomainToken      String?   @map("custom_domain_token")
  customDomainVerifiedAt DateTime? @map("custom_domain_verified_at")
  customDomainCheckedAt  DateTime? @map("custom_domain_checked_at")
  customDomainError      String?   @map("custom_domain_error")
  // Re-checks in a row that found the domain no longer pointing here (lib/domains.ts)
  customDomainFailures   Int       @default(0) @map("custom_domain_failures")
  // Trials (lib/tenant-lifecycle.ts): read-only once trialEndsAt passes
  trialEndsAt            DateTime? @map("trial_ends_at")
  trialReminderSentAt    DateTime? @map("trial_reminder_sent_at")
  trialEndedNotifiedAt   DateTime? @map("trial_ended_notified_at")
  // Closed by its own admins: suspended, then deleted after deleteAfter
  closedAt               DateTime? @map("closed_at")
  closedBy               String?   @map("closed_by")
  deleteAfter            DateTime? @map("delete_after")
  statusBeforeClose      TenantStatus? @map("status_before_close")
  // Billing (lib/billing/): set when a subscription's payments have failed for
  // longer than BILLING_GRACE_DAYS. The organization is read-only until it pays.
  paymentRequiredSince   DateTime? @map("payment_required_since")
  loginTitle      String?      @map("login_title")
  loginSubtitle   String?      @map("login_subtitle")

  // Provisioning (lib/provisioning.ts). Nobody signs in until READY.
  provisioningStatus ProvisioningStatus @default(PENDING) @map("provisioning_status")
  provisioningError  String?            @map("provisioning_error")
  provisionedAt      DateTime?          @map("provisioned_at")
  /// The first administrator, created and invited by the provisioning job
  initialAdminEmail  String?            @map("initial_admin_email")
  initialAdminName   String?            @map("initial_admin_name")
  adminInvitedAt     DateTime?          @map("admin_invited_at")
  // Why the first administrator's invitation email failed (it can be resent from the Tenants page)
  adminInviteError   String?            @map("admin_invite_error")
  /// The platform user who created the tenant (named in the invitation)
  createdById        String?            @map("created_by_id")

  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  databaseConfig     DatabaseConfig?
  tenantApplications TenantApplication[]
  supportSessions    SupportSession[]
  usage              TenantUsage?

  @@map("tenants")
  @@index([status])
  @@index([provisioningStatus])
}

enum ProvisioningStatus {
  PENDING
  PROVISIONING
  READY
  FAILED
  DEPROVISIONING
}

// Per-tenant figures for platform pages, refreshed by a periodic job
// (lib/tenant-usage.ts) so those pages don't query every tenant database.
model TenantUsage {
  tenantId       String    @id @map("tenant_id")
  users          Int       @default(0)
  applications   Int       @default(0)
  /// { RUNNING: 2, ... }
  appsByStatus   Json      @default("{}") @map("apps_by_status")
  lastActiveAt   DateTime? @map("last_active_at")
  /// [{ date: 'YYYY-MM-DD', count }] for the last 14 days
  activityByDay  Json      @default("[]") @map("activity_by_day")
  /// The latest few activity entries, with user names resolved
  recentActivity Json      @default("[]") @map("recent_activity")
  refreshedAt    DateTime  @default(now()) @map("refreshed_at")

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_usage")
}

enum TenantPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

// Where a tenant's data lives and how to reach it
model DatabaseConfig {
  id                String           @id @default(uuid())
  tenantId          String           @unique @map("tenant_id")
  strategy          DatabaseStrategy
  /// Tenant data is always on PostgreSQL: isolation relies on its roles,
  /// schemas and row-level security (see docs/tenant-isolation.md)
  provider          DatabaseProvider @default(POSTGRESQL)
  region            String
  backupEnabled     Boolean          @default(false) @map("backup_enabled")
  encryptionAtRest  Boolean          @default(false) @map("encryption_at_rest")
  maxConnections    Int              @default(100) @map("max_connections")
  storageLimit      String           @map("storage_limit")
  /// How the app connects as the tenant's role. Encrypted at rest (lib/secrets.ts).
  connectionString  String?          @map("connection_string")
  /// SCHEMA_PER_TENANT: the tenant's schema in the shared tenant database
  schemaName        String?          @map("schema_name")
  /// DATABASE_PER_TENANT: the tenant's database
  databaseName      String?          @map("database_name")
  tenantColumn      String?          @map("tenant_column")
  /// The tenant's own Postgres role. Set once at provisioning and never rebuilt
  /// from the slug, so renaming a slug can't break it.
  dbRoleName        String?          @unique @map("db_role_name")
  /// Tenant migrations (lib/tenant-migrations.ts): the latest applied here
  lastMigration     String?          @map("last_migration")
  migratedAt        DateTime?        @map("migrated_at")
  migrationError    String?          @map("migration_error")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("database_configs")
}

enum DatabaseStrategy {
  DATABASE_PER_TENANT
  SCHEMA_PER_TENANT
  SHARED_TABLES
}

// PostgreSQL only. Other engines would need their own isolation
// implementation (MySQL has no row-level security at all).
enum DatabaseProvider {
  POSTGRESQL
}

// People who run the platform. Tenant users are in the tenant plane.
model PlatformUser {
  id                 String           @id @default(uuid())
  email              String           @unique
  name               String?
  passwordHash       String?          @map("password_hash")
  userType           PlatformUserType @default(PLATFORM_USER) @map("user_type")
  status             UserStatus       @default(ACTIVE)
  lastLoginAt        DateTime?        @map("last_login_at")
  /// Access tokens issued before this are refused ("sign out everywhere")
  sessionsValidAfter DateTime?        @map("sessions_valid_after")
  /// Two-factor sign-in (lib/mfa.ts); the secret is encrypted at rest. Named
  /// apart from the tenant User's totpSecret because secret fields are keyed by name.
  platformTotpSecret String?          @map("totp_secret")
  mfaEnabledAt       DateTime?        @map("mfa_enabled_at")
  mfaRecoveryCodes   String[]         @default([]) @map("mfa_recovery_codes")
  mfaLastStep        Int?             @map("mfa_last_step")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  tokens             PlatformUserToken[]
  supportSessions    SupportSession[] @relation("SupportPlatformUser")
  approvedSupport    SupportSession[] @relation("SupportApprover")
  platformRoles      PlatformRoleAssignment[]

  @@map("platform_users")
  @@index([userType])
}

enum PlatformUserType {
  PLATFORM_ADMIN
  PLATFORM_USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

model PlatformRefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  token      String    @unique
  familyId   String    @map("family_id")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  sessionStartedAt DateTime @default(now()) @map("session_started_at")
  lastSeenAt       DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("platform_refresh_tokens")
}

// Single-use emailed tokens for platform users (password reset). Hash only.
model PlatformUserToken {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  type        UserTokenType
  tokenHash   String        @unique @map("token_hash")
  expiresAt   DateTime      @map("expires_at")
  usedAt      DateTime?     @map("used_at")
  createdById String?       @map("created_by_id")
  /// EMAIL_CHANGE: the address being confirmed
  newEmail    String?       @map("new_email")
  createdAt   DateTime      @default(now()) @map("created_at")

  user        PlatformUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("platform_user_tokens")
}

enum UserTokenType {
  INVITE
  PASSWORD_RESET
  // A new email address waiting for its owner to confirm it (new_email)
  EMAIL_CHANGE
}

// Platform-level audit trail (actions not inside one tenant's data)
model PlatformActivity {
  id         String       @id @default(uuid())
  /// The tenant the action concerned, if any
  tenantId   String?      @map("tenant_id")
  userId     String?      @map("user_id")
  action     String
  target     String
  type       ActivityType
  metadata   Json?
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([createdAt])
  @@map("platform_activities")
}

enum ActivityType {
  DEPLOY
  CONFIG
  USER
  BILLING
  ALERT
  AUTH
  API
}

// Platform-wide catalogue of applications tenants can be entitled to
model ApplicationRegistry {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  version     String
  status      String   @default("ACTIVE")
  /// Where an external product lives (its manifest's baseUrl, docs/PRODUCT_INTEGRATION.md)
  baseUrl            String?   @map("base_url")
  /// When its manifest was last imported
  manifestImportedAt DateTime? @map("manifest_imported_at")
  /// Where lifecycle events go (lib/product-lifecycle.ts); none: organizations need no setup
  provisioningCallbackUrl String?  @map("provisioning_callback_url")
  /// Signs lifecycle events (encrypted, lib/secrets.ts)
  callbackSigningSecret   String?  @map("callback_signing_secret")
  /// The secret before the last rotation, still signing alongside until it expires
  previousCallbackSigningSecret   String?   @map("previous_callback_signing_secret")
  previousCallbackSecretExpiresAt DateTime? @map("previous_callback_secret_expires_at")
  /// Whether it deletes an organization's data when told it left
  deletesDataOnDeprovision Boolean @default(false) @map("deletes_data_on_deprovision")
  /// specific (one domain) or generic (a capability others use); manifest v2 (docs/hub/MANIFEST_V2.md)
  kind             String  @default("specific")
  /// The manifest version it was last imported with
  manifestVersion  Int     @default(1) @map("manifest_version")
  /// Where its exposed API is described (manifest v2 api.openApiUrl)
  apiOpenApiUrl    String? @map("api_open_api_url")
  /// Also tell it when people in an organization change (lib/product-user-events.ts)
  userEvents       Boolean @default(false) @map("user_events")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenantApplications TenantApplication[]
  permissions        Permission[]
  signIn             ApplicationSignIn?
  menuItems          ApplicationMenuItem[]
  productEvents      ProductEvent[]
  serviceCredentials ProductServiceCredential[]
  memberStates       ProductMemberState[]
  logoutDeliveries   OidcLogoutDelivery[]
  declaredTypes      ProductDeclaredType[]
  apiScopes          ProductApiScope[]
  consumedScopes     ProductConsumedScope[]
  dependencies       ProductDependency[]
  embeds             ProductEmbed[]
  eventSubscriptions ProductEventSubscription[]
  publishedEvents    ProductPublishedEvent[]
  limits             ProductLimit[]
  usageMeters        ProductUsageMeter[]
  usageRecords       ProductUsageRecord[]
  bundleEntries      BundleApplication[]
  callingConnections AppConnectionState[] @relation("ConnectionCaller")
  calledConnections  AppConnectionState[] @relation("ConnectionTarget")

  @@index([status])
  @@map("application_registries")
}

// "Sign in with" for an application in the catalogue: the platform is its
// OpenID Connect provider (lib/oidc/). People sign in to it with their
// organization account, if their organization has the application turned on.
model ApplicationSignIn {
  id                     String               @id @default(uuid())
  applicationId          String               @unique @map("application_id")
  enabled                Boolean              @default(false)
  /// The OAuth client_id; public, shown to the application's developers
  clientId               String               @unique @map("client_id")
  clientType             OidcClientType       @default(CONFIDENTIAL) @map("client_type")
  /// The client secret, encrypted (lib/secrets.ts); null for public clients
  oidcClientSecret       String?              @map("client_secret")
  secretCreatedAt        DateTime?            @map("secret_created_at")
  redirectUris           String[]             @default([]) @map("redirect_uris")
  postLogoutRedirectUris String[]             @default([]) @map("post_logout_redirect_uris")
  /// Where the catalogue sends people to open the application (initiate_login_uri)
  initiateLoginUri       String?              @map("initiate_login_uri")
  /// Where to send a logout token when the platform ends a person's sessions (OpenID Connect Back-Channel Logout; lib/oidc/logout.ts)
  backchannelLogoutUri   String?              @map("backchannel_logout_uri")
  /// How long its access tokens last, in seconds
  accessTokenLifetime    Int                  @default(900) @map("access_token_lifetime")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  application            ApplicationRegistry  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_sign_ins")
}

// An external product's pages in the tenant portal's sidebar, from its
// manifest (docs/PRODUCT_INTEGRATION.md): shown to organizations that have it
// turned on, to the people who hold the permission
model ApplicationMenuItem {
  id            String              @id @default(uuid())
  applicationId String              @map("application_id")
  label         String
  /// Relative to the application's baseUrl, starting with "/"
  path          String
  icon          String?
  permission    String?
  order         Int                 @default(0)

  application   ApplicationRegistry @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_menu_items")
}

// An external product's credentials for calling API v1 itself, for the
// organizations that have it on (lib/product-service.ts): OAuth client
// credentials, separate from its sign-in client. Several at once, so one can
// be replaced without downtime; revoked ones stop working at once.
model ProductServiceCredential {
  id            String              @id @default(uuid())
  applicationId String              @map("application_id")
  name          String
  /// The OAuth client_id (mts_…)
  clientId      String              @unique @map("client_id")
  /// Encrypted (lib/secrets.ts)
  serviceClientSecret String        @map("client_secret")
  scopes        String[]            @default([])
  createdBy     String?             @map("created_by")
  createdAt     DateTime            @default(now()) @map("created_at")
  lastUsedAt    DateTime?           @map("last_used_at")
  revokedAt     DateTime?           @map("revoked_at")

  application   ApplicationRegistry @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("product_service_credentials")
}

enum OidcClientType {
  CONFIDENTIAL // a server that can keep a secret
  PUBLIC       // a browser or mobile app: PKCE only, no secret
}

// What the OpenID Connect provider keeps between requests (lib/oidc/adapter.ts):
// sessions, interactions, authorization codes, tokens and grants, by model
model OidcPayload {
  model      String
  id         String
  payload    Json
  grantId    String?   @map("grant_id")
  userCode   String?   @map("user_code")
  uid        String?
  expiresAt  DateTime? @map("expires_at")
  consumedAt DateTime? @map("consumed_at")

  @@id([model, id])
  @@index([grantId])
  @@index([uid])
  @@index([userCode])
  @@index([expiresAt])
  @@map("oidc_payloads")
}

// Keys the provider signs ID tokens with (lib/oidc/keys.ts). Made on first use;
// the private key is encrypted (lib/secrets.ts). Retired keys stay published
// for a while so tokens signed with them still verify.
model OidcSigningKey {
  id         String    @id // the JWK's kid
  privateJwk String    @map("private_jwk")
  createdAt  DateTime  @default(now()) @map("created_at")
  retiredAt  DateTime? @map("retired_at")

  @@map("oidc_signing_keys")
}

// Permissions an application in the registry declares (shown on the Applications
// page). Tenant roles reference permissions by name; the kit's own catalogue is
// in code (src/utils/permissions.ts).
model Permission {
  id            String               @id @default(uuid())
  applicationId String?              @map("application_id")
  name          String               @unique
  description   String?
  resource      String
  action        String
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  application   ApplicationRegistry? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([resource, action])
  @@map("permissions")
}

// A tenant's entitlement to an application (granted by the platform)
model TenantApplication {
  id            String              @id @default(uuid())
  tenantId      String              @map("tenant_id")
  applicationId String              @map("application_id")
  state         String              @default("ENABLED") // ENABLED, DISABLED, TRIAL
  validFrom     DateTime            @default(now()) @map("valid_from")
  validTo       DateTime?           @map("valid_to")
  /// Whether the application has set the organization up (lib/product-lifecycle.ts)
  provisioningStatus EntitlementProvisioning @default(NOT_REQUIRED) @map("provisioning_status")
  provisioningError  String?        @map("provisioning_error")
  provisionedAt      DateTime?      @map("provisioned_at")
  /// Rises with each setup operation; a report for an older one is refused
  provisioningGeneration  Int       @default(0) @map("provisioning_generation")
  provisioningOperationId String?   @map("provisioning_operation_id")
  /// A hash of the organization's own organizations and units as last told (user events: units.changed)
  unitsStateHash String?            @map("units_state_hash")
  /// A hash of the limits as last told (organization.entitlement_changed carries them: lib/product-limits.ts)
  limitsStateHash String?           @map("limits_state_hash")
  createdAt     DateTime            @default(now()) @map("created_at")

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application   ApplicationRegistry @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, applicationId])
  @@index([applicationId])
  @@index([state])
  @@map("tenant_applications")
}

enum EntitlementProvisioning {
  NOT_REQUIRED // the application takes no lifecycle events
  PENDING      // told, not set up yet
  READY
  FAILED
}

// Lifecycle events for external products (lib/product-lifecycle.ts,
// docs/PRODUCT_INTEGRATION.md): an outbox, sent signed and in order per
// product and organization, retried with backoff
model ProductEvent {
  id            String             @id @default(uuid())
  /// Orders events per product and organization
  seq           Int                @unique @default(autoincrement())
  /// The event's id as the product sees it (webhook-id), evt_…
  publicId      String             @unique @map("public_id")
  applicationId String             @map("application_id")
  /// No foreign key: an organization's last event outlives it
  tenantId      String             @map("tenant_id")
  type          String
  payload       Json
  /// The setup operation it belongs to (organization.entitled starts one)
  operationId   String?            @map("operation_id")
  generation    Int?
  status        ProductEventStatus @default(PENDING)
  attempts      Int                @default(0)
  nextAttemptAt DateTime           @default(now()) @map("next_attempt_at")
  claimedAt     DateTime?          @map("claimed_at")
  lastStatus    Int?               @map("last_status")
  lastError     String?            @map("last_error")
  deliveredAt   DateTime?          @map("delivered_at")
  createdAt     DateTime           @default(now()) @map("created_at")

  application   ApplicationRegistry @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([applicationId, tenantId, seq])
  @@map("product_events")
}

enum ProductEventStatus {
  PENDING
  DELIVERED
  FAILED
}

// A platform user's time-limited access into a tenant
// A platform user's time-limited access to one tenant's data (lib/support.ts).
// Without an active session, platform users can't work inside a tenant at all.
// Requested with a reason, approved by someone else with support:manage
// (unless SUPPORT_SELF_APPROVAL is on), read-only unless approved otherwise,
// and visible to the tenant (audit log and notifications).
model SupportSession {
  id              String               @id @default(uuid())
  platformUserId  String               @map("platform_user_id")
  tenantId        String               @map("tenant_id")
  approvedBy      String?              @map("approved_by")
  approvedAt      DateTime?            @map("approved_at")
  reason          String
  access          SupportAccess        @default(READ_ONLY)
  /// READ_WRITE: the tenant permissions granted (reading is always included)
  permissions     Json
  /// How long the session lasts once approved
  durationMinutes Int                  @default(60) @map("duration_minutes")
  validFrom       DateTime?            @map("valid_from")
  validTo         DateTime?            @map("valid_to")
  status          SupportSessionStatus @default(PENDING)
  decisionNote    String?              @map("decision_note")
  revokedAt       DateTime?            @map("revoked_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  platformUser    PlatformUser  @relation("SupportPlatformUser", fields: [platformUserId], references: [id], onDelete: Cascade)
  approver        PlatformUser? @relation("SupportApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([platformUserId, tenantId, status])
  @@map("support_sessions")
}

enum SupportAccess {
  READ_ONLY
  READ_WRITE
}

enum SupportSessionStatus {
  PENDING
  ACTIVE
  REJECTED
  REVOKED
  EXPIRED
}

// Platform roles: sets of platform permissions given to platform users, on
// top of what their user type grants (utils/authorization.ts). Only platform
// permissions can be in them; built-in roles (isSystem) are kept up to date
// at start-up and can't be edited.
model PlatformRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[]
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  assignments PlatformRoleAssignment[]

  @@map("platform_roles")
}

model PlatformRoleAssignment {
  id             String       @id @default(uuid())
  platformUserId String       @map("platform_user_id")
  roleId         String       @map("role_id")
  assignedBy     String?      @map("assigned_by")
  createdAt      DateTime     @default(now()) @map("created_at")

  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  role           PlatformRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([platformUserId, roleId])
  @@index([roleId])
  @@map("platform_role_assignments")
}

// Database-driven navigation for both portals
model MenuItem {
  id          String     @id @default(uuid())
  portal      String     // PLATFORM, TENANT
  parentId    String?    @map("parent_id")
  label       String
  path        String
  icon        String?
  permission  String?
  order       Int        @default(0)
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  parent      MenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    MenuItem[] @relation("MenuHierarchy")

  @@index([portal, isActive, order])
  @@index([parentId])
  @@map("menu_items")
}

// Audit log of platform actions (src/lib/audit.ts): the same shape and hash
// chain as each tenant's audit_events, as one chain ("platform").
model PlatformAuditEvent {
  id            String         @id @default(uuid())
  /// The tenant the action concerned, if any
  tenantId      String?        @map("tenant_id")
  seq           Int            @unique
  occurredAt    DateTime       @default(now()) @map("occurred_at")
  event         String
  category      String
  outcome       AuditOutcome   @default(SUCCESS)
  actorType     AuditActorType @map("actor_type")
  actorId       String?        @map("actor_id")
  actorEmail    String?        @map("actor_email")
  resourceType  String?        @map("resource_type")
  resourceId    String?        @map("resource_id")
  resourceLabel String?        @map("resource_label")
  changes       Json?
  details       Json?
  ip            String?
  userAgent     String?        @map("user_agent")
  requestId     String?        @map("request_id")
  prevHash      String         @map("prev_hash")
  hash          String
  keyVersion    Int            @map("key_version")

  @@index([occurredAt])
  @@index([tenantId])
  @@index([event])
  @@map("platform_audit_events")
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

enum AuditActorType {
  USER
  PLATFORM
  SYSTEM
  ANONYMOUS
  /// An API key (lib/api-keys.ts)
  API_KEY
  /// An external product, with a service token (lib/product-services.ts)
  APPLICATION
}

// The latest entry of each audit chain ("platform" or a tenant id), kept
// apart from the tenant's own data: removing entries from the end of a
// tenant's chain is then detectable too.
model AuditHead {
  chain     String   @id
  seq       Int
  hash      String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("audit_heads")
}

// Audit entries moved out of the live tables after the retention period:
// one gzipped JSON-lines file per run and chain, with what's needed to keep
// verifying the chain across it.
model AuditArchive {
  id        String   @id @default(uuid())
  chain     String
  tenantId  String?  @map("tenant_id")
  fromSeq   Int      @map("from_seq")
  toSeq     Int      @map("to_seq")
  fromAt    DateTime @map("from_at")
  toAt      DateTime @map("to_at")
  rows      Int
  /// prev_hash of the first entry and hash of the last
  firstPrevHash String @map("first_prev_hash")
  lastHash  String   @map("last_hash")
  /// Path under AUDIT_ARCHIVE_DIR
  file      String
  sha256    String
  bytes     Int
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([chain, fromSeq])
  @@index([tenantId])
  @@map("audit_archives")
}

// Platform users' notifications: the same shapes as the tenant plane's
// (prisma/tenant/kit/notifications.prisma), without the tenant.
model PlatformNotification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  title     String
  body      String?
  link      String?
  data      Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("platform_notifications")
}

model PlatformNotificationOutbox {
  id            String                   @id @default(uuid())
  kind          NotificationOutboxKind
  status        NotificationOutboxStatus @default(PENDING)
  payload       Json
  attempts      Int                      @default(0)
  nextAttemptAt DateTime                 @default(now()) @map("next_attempt_at")
  claimedAt     DateTime?                @map("claimed_at")
  lastError     String?                  @map("last_error")
  createdAt     DateTime                 @default(now()) @map("created_at")

  @@index([status, nextAttemptAt])
  @@map("platform_notification_outbox")
}

enum NotificationOutboxKind {
  EVENT
  EMAIL
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  FAILED
}

model PlatformNotificationPreference {
  id     String  @id @default(uuid())
  userId String  @map("user_id")
  type   String
  inApp  Boolean @map("in_app")
  email  Boolean

  @@unique([userId, type])
  @@map("platform_notification_preferences")
}

// Which tenants (or "platform") have notification work due, so the worker
// only visits those instead of every tenant database.
model NotificationWork {
  chain     String   @id
  dueAt     DateTime @map("due_at")

  @@index([dueAt])
  @@map("notification_work")
}

// Request counters for the rate limits that must hold across every server
// (sign-in, one-time and two-factor codes): lib/rate-limit-store.ts. The key
// is a hash, so no email addresses are stored here.
model RateLimitHit {
  key       String   @id
  count     Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("rate_limit_hits")
}

enum CustomDomainStatus {
  PENDING
  VERIFIED
}

// Someone signing up for a new organization (routes/signup.ts): kept until
// they confirm their email, then the tenant is created. The password is only
// ever a hash, and is cleared once their account has it.
model SignupRequest {
  id           String    @id @default(uuid())
  email        String
  name         String
  organization String
  slug         String
  passwordHash String?   @map("password_hash")
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  verifiedAt   DateTime? @map("verified_at")
  tenantId     String?   @unique @map("tenant_id")
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@index([expiresAt])
  @@map("signup_requests")
}

// An organization's data, downloaded as a ZIP of CSV files (lib/data-export.ts).
// The file is in EXPORT_DIR; the row says who asked, how it went, and until when
// it can be downloaded.
enum DataExportStatus {
  PENDING
  RUNNING
  READY
  FAILED
}

model DataExport {
  id             String           @id @default(uuid())
  tenantId       String           @map("tenant_id")
  requestedById  String?          @map("requested_by_id")
  requestedBy    String?          @map("requested_by")
  status         DataExportStatus @default(PENDING)
  error          String?
  sizeBytes      BigInt?          @map("size_bytes")
  /// Tables and row counts, as in the file's manifest
  tables         Json?
  createdAt      DateTime         @default(now()) @map("created_at")
  startedAt      DateTime?        @map("started_at")
  finishedAt     DateTime?        @map("finished_at")
  expiresAt      DateTime?        @map("expires_at")
  downloadCount  Int              @default(0) @map("download_count")

  @@index([tenantId, createdAt])
  @@index([status])
  @@map("data_exports")
}

// --- Billing (lib/billing/, docs/BILLING.md) --------------------------------

// What each plan allows. One row per TenantPlan; platform staff edit them
// (Platform → Plans). A null limit means no limit.
model BillingPlan {
  code             TenantPlan @id
  name             String
  description      String?
  /// Offered on organizations' Billing page (Enterprise is usually arranged by hand)
  public           Boolean    @default(true)
  sortOrder        Int        @default(0) @map("sort_order")
  maxUsers         Int?       @map("max_users")
  maxOrganizations Int?       @map("max_organizations")
  maxGroups        Int?       @map("max_groups")
  allowSso         Boolean    @default(false) @map("allow_sso")
  allowCustomDomain Boolean   @default(false) @map("allow_custom_domain")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  prices           BillingPrice[]

  @@map("billing_plans")
}

enum BillingProvider {
  RAZORPAY
  STRIPE
}

enum BillingInterval {
  MONTH
  YEAR
}

// A price per user (seat) for a plan, in one currency and billing interval,
// with the matching object at the payment provider (a Razorpay plan, a Stripe
// price). Prices can't change at the providers: a new price is a new row,
// and the old one is kept (inactive) for the subscriptions still on it.
model BillingPrice {
  id               String          @id @default(uuid())
  planCode         TenantPlan      @map("plan_code")
  provider         BillingProvider
  currency         String
  interval         BillingInterval
  /// Per seat, in the currency's smallest unit (paise, cents)
  unitAmount       Int             @map("unit_amount")
  providerPriceId  String          @unique @map("provider_price_id")
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now()) @map("created_at")

  plan             BillingPlan     @relation(fields: [planCode], references: [code], onDelete: Cascade)

  @@index([planCode, active])
  @@map("billing_prices")
}

enum SubscriptionStatus {
  /// Created at the provider; the customer hasn't paid or authorised yet
  INCOMPLETE
  ACTIVE
  /// A payment failed; the provider is retrying
  PAST_DUE
  /// Retries ran out (Stripe unpaid, Razorpay halted)
  UNPAID
  CANCELED
}

// An organization's subscription: one at a time (a new one replaces an ended one)
model Subscription {
  id                     String             @id @default(uuid())
  tenantId               String             @unique @map("tenant_id")
  provider               BillingProvider
  providerSubscriptionId String             @unique @map("provider_subscription_id")
  providerCustomerId     String?            @map("provider_customer_id")
  planCode               TenantPlan         @map("plan_code")
  priceId                String             @map("price_id")
  currency               String
  interval               BillingInterval
  seats                  Int
  status                 SubscriptionStatus
  currentPeriodEnd       DateTime?          @map("current_period_end")
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  /// When payments started failing (the grace period counts from here)
  pastDueSince           DateTime?          @map("past_due_since")
  /// Where the customer pays or authorises (Razorpay's subscription link)
  checkoutUrl            String?            @map("checkout_url")
  /// Why the seat count couldn't be changed at the provider, if it couldn't
  seatSyncError          String?            @map("seat_sync_error")
  seatsSyncedAt          DateTime?          @map("seats_synced_at")
  createdById            String?            @map("created_by_id")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  @@index([status])
  @@map("subscriptions")
}

// Invoices from the providers, kept so organizations can see and download them
model Invoice {
  id                String          @id @default(uuid())
  tenantId          String          @map("tenant_id")
  provider          BillingProvider
  providerInvoiceId String          @unique @map("provider_invoice_id")
  number            String?
  /// In the currency's smallest unit
  amount            Int
  currency          String
  status            String
  url               String?
  periodStart       DateTime?       @map("period_start")
  periodEnd         DateTime?       @map("period_end")
  paidAt            DateTime?       @map("paid_at")
  createdAt         DateTime        @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("invoices")
}

// Webhook deliveries from the providers, by their event id: each is handled once
model BillingEvent {
  id          String          @id @default(uuid())
  provider    BillingProvider
  eventId     String          @map("event_id")
  type        String
  tenantId    String?         @map("tenant_id")
  receivedAt  DateTime        @default(now()) @map("received_at")
  processedAt DateTime?       @map("processed_at")
  error       String?

  @@unique([provider, eventId])
  @@index([receivedAt])
  @@map("billing_events")
}

// Organizations with webhook deliveries waiting (lib/webhooks.ts), so the
// sender doesn't have to look in every tenant's database
model WebhookWork {
  tenantId String   @id @map("tenant_id")
  dueAt    DateTime @map("due_at")

  @@index([dueAt])
  @@map("webhook_work")
}

/// What a product was last told about each person in an organization
/// (lib/product-user-events.ts): enough to tell what changed, no plain
/// personal data (email and name are kept as keyed hashes)
model ProductMemberState {
  applicationId   String   @map("application_id")
  tenantId        String   @map("tenant_id")
  userId          String   @map("user_id")
  status          String
  userType        String   @map("user_type")
  emailHash       String   @map("email_hash")
  nameHash        String   @map("name_hash")
  /// The product's own permissions the person holds (names, sorted)
  permissions     String[] @default([])
  /// Of those, held in part of the organization only (permission@SCOPE_TYPE:id, sorted)
  scopedPermissions String[] @default([]) @map("scoped_permissions")
  /// Organizations (ORGANIZATION:id) and units (ORG_UNIT:id) they are directly in, sorted
  units           String[] @default([])
  /// Whether scopedPermissions and units were recorded (rows from before they were tracked: record silently)
  unitsRecorded   Boolean  @default(false) @map("units_recorded")
  updatedAt       DateTime @updatedAt @map("updated_at")

  application     ApplicationRegistry @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@id([applicationId, tenantId, userId])
  @@index([tenantId])
  @@map("product_member_states")
}

/// Logout tokens to send (lib/oidc/logout.ts): an outbox, retried with backoff
model OidcLogoutDelivery {
  id            String              @id @default(uuid())
  applicationId String              @map("application_id")
  clientId      String              @map("client_id")
  /// The person: <tenant id>.<user id>
  accountId     String              @map("account_id")
  reason        String
  status        ProductEventStatus  @default(PENDING)
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @default(now()) @map("next_attempt_at")
  claimedAt     DateTime?           @map("claimed_at")
  lastStatus    Int?                @map("last_status")
  lastError     String?             @map("last_error")
  deliveredAt   DateTime?           @map("delivered_at")
  createdAt     DateTime            @default(now()) @map("created_at")

  application   ApplicationRegistry @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([applicationId, createdAt])
  @@map("oidc_logout_deliveries")
}

/// Notification and audit event types an external product declares in its
/// manifest (platformServices; lib/product-catalog.ts). Kept when they leave
/// the manifest (retired), so organizations' rules and saved webhooks still
/// make sense.
model ProductDeclaredType {
  id             String              @id @default(uuid())
  applicationId  String              @map("application_id")
  /// notification, audit or event (an event it publishes: lib/product-events.ts)
  kind           String
  /// <productId>.<name>, unique across the platform
  type           String              @unique
  label          String
  description    String?
  defaultInApp   Boolean             @default(true) @map("default_in_app")
  defaultEmail   Boolean             @default(false) @map("default_email")
  /// For events: where the JSON Schema of data is published (informational)
  schemaUrl      String?             @map("schema_url")
  /// Order in the manifest
  position       Int                 @default(0)
  retiredAt      DateTime?           @map("retired_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  application    ApplicationRegistry @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("product_declared_types")
}

/// Scopes an application exposes to other applications (manifest v2
/// api.scopes; docs/adr/0001-app-to-app-calls.md). Its audience is always
/// urn:mt:app:<productId>. Kept when they leave the manifest (retired).
model ProductApiScope {
  id               String              @id @default(uuid())
  applicationId    String              @map("application_id")
  /// <productId>[.<thing>]:<action>, unique across the platform
  name             String              @unique
  description      String
  allowsOnBehalfOf Boolean             @default(false) @map("allows_on_behalf_of")
  position         Int                 @default(0)
  retiredAt        DateTime?           @map("retired_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  application      ApplicationRegistry @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("product_api_scopes")
}

/// Scopes an application needs from other applications (manifest v2
/// consumes), with the reason shown to organizations. Replaced on import.
model ProductConsumedScope {
  id            String              @id @default(uuid())
  applicationId String              @map("application_id")
  scope         String
  reason        String
  position      Int                 @default(0)

  application   ApplicationRegistry @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, scope])
  @@map("product_consumed_scopes")
}

/// One organization's view of one application calling another
/// (lib/app-connections.ts): blocked by its administrators, and how many
/// tokens were issued for it
model AppConnectionState {
  tenantId            String              @map("tenant_id")
  callerApplicationId String              @map("caller_application_id")
  targetApplicationId String              @map("target_application_id")
  blockedAt           DateTime?           @map("blocked_at")
  blockedByEmail      String?             @map("blocked_by_email")
  tokensIssued        Int                 @default(0) @map("tokens_issued")
  lastIssuedAt        DateTime?           @map("last_issued_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  caller              ApplicationRegistry @relation("ConnectionCaller", fields: [callerApplicationId], references: [id], onDelete: Cascade)
  target              ApplicationRegistry @relation("ConnectionTarget", fields: [targetApplicationId], references: [id], onDelete: Cascade)

  @@id([tenantId, callerApplicationId, targetApplicationId])
  @@index([tenantId])
  @@map("app_connection_states")
}

/// Another application this one needs (requires) or works with
/// (integratesWith); manifest v2 (lib/app-dependencies.ts). By product id,
/// because the other application may be registered later. Replaced on import.
model ProductDependency {
  id            String              @id @default(uuid())
  applicationId String              @map("application_id")
  /// requires or integrates
  kind          String
  /// The other application's productId
  productKey    String              @map("product_key")
  reason        String
  position      Int                 @default(0)

  application   ApplicationRegistry @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, productKey])
  @@index([productKey])
  @@map("product_dependencies")
}

/// A named set of applications organizations turn on together, defined by
/// platform staff (e.g. "Sales suite")
/// A Web Component an application offers other applications (manifest v2 embeds; lib/product-embeds.ts)
model ProductEmbed {
  id            String              @id @default(uuid())
  applicationId String              @map("application_id")
  /// A custom element name starting with the product's key
  tag           String              @unique
  scriptUrl     String              @map("script_url")
  attributes    String[]            @default([])
  description   String
  position      Int                 @default(0)
  createdAt     DateTime            @default(now()) @map("created_at")

  application   ApplicationRegistry @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("product_embeds")
}

/// An event type an application wants to receive from others (manifest v2 events.subscribes)
model ProductEventSubscription {
  id            String              @id @default(uuid())
  applicationId String              @map("application_id")
  type          String
  reason        String
  position      Int                 @default(0)

  application   ApplicationRegistry @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, type])
  @@index([type])
  @@map("product_event_subscriptions")
}

/// An event an application published for an organization (lib/product-events.ts): for idempotency and what organizations see
model ProductPublishedEvent {
  /// evt_…, the id every copy carries (data.eventId)
  id             String              @id
  applicationId  String              @map("application_id")
  tenantId       String              @map("tenant_id")
  type           String
  idempotencyKey String?             @map("idempotency_key")
  /// How many applications and webhook endpoints it was queued for
  applications   Int                 @default(0)
  webhooks       Int                 @default(0)
  createdAt      DateTime            @default(now()) @map("created_at")

  application    ApplicationRegistry @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, tenantId, idempotencyKey], map: "product_published_events_idempotency_key")
  @@index([tenantId, type, createdAt])
  @@map("product_published_events")
}

/// A limit an application's plans set (manifest v2 limits; lib/product-limits.ts)
model ProductLimit {
  id            String              @id @default(uuid())
  applicationId String              @map("application_id")
  /// <productId>.<name>, unique across the platform
  key           String              @unique
  label         String
  /// integer or boolean
  type          String
  /// integer: whether a plan may set no limit
  unlimited     Boolean             @default(false)
  /// For plans without a value: { "v": number | null | boolean }
  defaultValue  Json                @map("default_value")
  unit          String?
  position      Int                 @default(0)
  retiredAt     DateTime?           @map("retired_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  application   ApplicationRegistry @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  planValues    ProductPlanLimit[]

  @@index([applicationId])
  @@map("product_limits")
}

/// A plan's value for an application's limit, set by platform staff
model ProductPlanLimit {
  id        String       @id @default(uuid())
  limitId   String       @map("limit_id")
  planCode  TenantPlan   @map("plan_code")
  /// { "v": number | null | boolean }
  value     Json
  updatedAt DateTime     @updatedAt @map("updated_at")

  limit     ProductLimit @relation(fields: [limitId], references: [id], onDelete: Cascade)

  @@unique([limitId, planCode])
  @@map("product_plan_limits")
}

/// A metered feature an application reports usage of (manifest v2 usage; lib/product-usage.ts)
model ProductUsageMeter {
  id            String              @id @default(uuid())
  applicationId String              @map("application_id")
  key           String              @unique
  label         String
  unit          String
  position      Int                 @default(0)
  retiredAt     DateTime?           @map("retired_at")
  createdAt     DateTime            @default(now()) @map("created_at")

  application   ApplicationRegistry @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("product_usage_meters")
}

/// Usage an application reported for an organization
model ProductUsageRecord {
  id             String              @id @default(uuid())
  applicationId  String              @map("application_id")
  tenantId       String              @map("tenant_id")
  meterKey       String              @map("meter_key")
  quantity       Float
  occurredAt     DateTime            @map("occurred_at")
  idempotencyKey String?             @map("idempotency_key")
  createdAt      DateTime            @default(now()) @map("created_at")

  application    ApplicationRegistry @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, tenantId, idempotencyKey], map: "product_usage_records_idempotency_key")
  @@index([tenantId, meterKey, occurredAt])
  @@index([applicationId, occurredAt])
  @@map("product_usage_records")
}

model Bundle {
  id           String              @id @default(uuid())
  key          String              @unique
  name         String
  description  String?
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  applications BundleApplication[]

  @@map("bundles")
}

model BundleApplication {
  bundleId      String              @map("bundle_id")
  applicationId String              @map("application_id")
  position      Int                 @default(0)

  bundle        Bundle              @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  application   ApplicationRegistry @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@id([bundleId, applicationId])
  @@map("bundle_applications")
}
