// Control plane: the platform's own data. Platform users, tenants and how
// to reach each tenant's data, the app catalogue, menus, support sessions.
// Nothing tenant-owned lives here; that's the tenant schema (prisma/tenant).
// Migrated once, against DATABASE_URL. Config: prisma.config.ts.

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/control"
}

datasource db {
  provider = "postgresql"
}

// A customer organization. Its users, roles and data live in the tenant plane.
model Tenant {
  id              String       @id @default(uuid())
  name            String
  slug            String       @unique
  plan            TenantPlan
  status          TenantStatus

  // Branding (read before sign-in)
  logoUrl         String?      @map("logo_url")
  primaryColor    String?      @default("#3b82f6") @map("primary_color")
  customDomain    String?      @unique @map("custom_domain")
  loginTitle      String?      @map("login_title")
  loginSubtitle   String?      @map("login_subtitle")

  // Provisioning (lib/provisioning.ts). Nobody signs in until READY.
  provisioningStatus ProvisioningStatus @default(PENDING) @map("provisioning_status")
  provisioningError  String?            @map("provisioning_error")
  provisionedAt      DateTime?          @map("provisioned_at")
  /// The first administrator, created and invited by the provisioning job
  initialAdminEmail  String?            @map("initial_admin_email")
  initialAdminName   String?            @map("initial_admin_name")
  adminInvitedAt     DateTime?          @map("admin_invited_at")
  /// The platform user who created the tenant (named in the invitation)
  createdById        String?            @map("created_by_id")

  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  databaseConfig     DatabaseConfig?
  tenantApplications TenantApplication[]
  supportSessions    SupportSession[]
  usage              TenantUsage?

  @@map("tenants")
  @@index([status])
  @@index([provisioningStatus])
}

enum ProvisioningStatus {
  PENDING
  PROVISIONING
  READY
  FAILED
  DEPROVISIONING
}

// Per-tenant figures for platform pages, refreshed by a periodic job
// (lib/tenant-usage.ts) so those pages don't query every tenant database.
model TenantUsage {
  tenantId       String    @id @map("tenant_id")
  users          Int       @default(0)
  applications   Int       @default(0)
  /// { RUNNING: 2, ... }
  appsByStatus   Json      @default("{}") @map("apps_by_status")
  lastActiveAt   DateTime? @map("last_active_at")
  /// [{ date: 'YYYY-MM-DD', count }] for the last 14 days
  activityByDay  Json      @default("[]") @map("activity_by_day")
  /// The latest few activity entries, with user names resolved
  recentActivity Json      @default("[]") @map("recent_activity")
  refreshedAt    DateTime  @default(now()) @map("refreshed_at")

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_usage")
}

enum TenantPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

// Where a tenant's data lives and how to reach it
model DatabaseConfig {
  id                String           @id @default(uuid())
  tenantId          String           @unique @map("tenant_id")
  strategy          DatabaseStrategy
  /// Tenant data is always on PostgreSQL: isolation relies on its roles,
  /// schemas and row-level security (see docs/tenant-isolation.md)
  provider          DatabaseProvider @default(POSTGRESQL)
  region            String
  backupEnabled     Boolean          @default(false) @map("backup_enabled")
  encryptionAtRest  Boolean          @default(false) @map("encryption_at_rest")
  maxConnections    Int              @default(100) @map("max_connections")
  storageLimit      String           @map("storage_limit")
  /// How the app connects as the tenant's role. Encrypted at rest (lib/secrets.ts).
  connectionString  String?          @map("connection_string")
  /// SCHEMA_PER_TENANT: the tenant's schema in the shared tenant database
  schemaName        String?          @map("schema_name")
  /// DATABASE_PER_TENANT: the tenant's database
  databaseName      String?          @map("database_name")
  tenantColumn      String?          @map("tenant_column")
  /// The tenant's own Postgres role. Set once at provisioning and never rebuilt
  /// from the slug, so renaming a slug can't break it.
  dbRoleName        String?          @unique @map("db_role_name")
  /// Tenant migrations (lib/tenant-migrations.ts): the latest applied here
  lastMigration     String?          @map("last_migration")
  migratedAt        DateTime?        @map("migrated_at")
  migrationError    String?          @map("migration_error")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("database_configs")
}

enum DatabaseStrategy {
  DATABASE_PER_TENANT
  SCHEMA_PER_TENANT
  SHARED_TABLES
}

// PostgreSQL only. Other engines would need their own isolation
// implementation (MySQL has no row-level security at all).
enum DatabaseProvider {
  POSTGRESQL
}

// People who run the platform. Tenant users are in the tenant plane.
model PlatformUser {
  id                 String           @id @default(uuid())
  email              String           @unique
  name               String?
  passwordHash       String?          @map("password_hash")
  userType           PlatformUserType @default(PLATFORM_USER) @map("user_type")
  status             UserStatus       @default(ACTIVE)
  lastLoginAt        DateTime?        @map("last_login_at")
  /// Access tokens issued before this are refused ("sign out everywhere")
  sessionsValidAfter DateTime?        @map("sessions_valid_after")
  /// Two-factor sign-in (lib/mfa.ts); the secret is encrypted at rest. Named
  /// apart from the tenant User's totpSecret because secret fields are keyed by name.
  platformTotpSecret String?          @map("totp_secret")
  mfaEnabledAt       DateTime?        @map("mfa_enabled_at")
  mfaRecoveryCodes   String[]         @default([]) @map("mfa_recovery_codes")
  mfaLastStep        Int?             @map("mfa_last_step")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  tokens             PlatformUserToken[]
  supportSessions    SupportSession[] @relation("SupportPlatformUser")
  approvedSupport    SupportSession[] @relation("SupportApprover")
  platformRoles      PlatformRoleAssignment[]

  @@map("platform_users")
  @@index([userType])
}

enum PlatformUserType {
  PLATFORM_ADMIN
  PLATFORM_USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

model PlatformRefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  token      String    @unique
  familyId   String    @map("family_id")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  sessionStartedAt DateTime @default(now()) @map("session_started_at")
  lastSeenAt       DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("platform_refresh_tokens")
}

// Single-use emailed tokens for platform users (password reset). Hash only.
model PlatformUserToken {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  type        UserTokenType
  tokenHash   String        @unique @map("token_hash")
  expiresAt   DateTime      @map("expires_at")
  usedAt      DateTime?     @map("used_at")
  createdById String?       @map("created_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")

  user        PlatformUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("platform_user_tokens")
}

enum UserTokenType {
  INVITE
  PASSWORD_RESET
}

// Platform-level audit trail (actions not inside one tenant's data)
model PlatformActivity {
  id         String       @id @default(uuid())
  /// The tenant the action concerned, if any
  tenantId   String?      @map("tenant_id")
  userId     String?      @map("user_id")
  action     String
  target     String
  type       ActivityType
  metadata   Json?
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([createdAt])
  @@map("platform_activities")
}

enum ActivityType {
  DEPLOY
  CONFIG
  USER
  BILLING
  ALERT
  AUTH
  API
}

// Platform-wide catalogue of applications tenants can be entitled to
model ApplicationRegistry {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  version     String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenantApplications TenantApplication[]
  permissions        Permission[]

  @@index([status])
  @@map("application_registries")
}

// Permissions an application in the registry declares (shown on the Applications
// page). Tenant roles reference permissions by name; the kit's own catalogue is
// in code (src/utils/permissions.ts).
model Permission {
  id            String               @id @default(uuid())
  applicationId String?              @map("application_id")
  name          String               @unique
  description   String?
  resource      String
  action        String
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  application   ApplicationRegistry? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([resource, action])
  @@map("permissions")
}

// A tenant's entitlement to an application (granted by the platform)
model TenantApplication {
  id            String              @id @default(uuid())
  tenantId      String              @map("tenant_id")
  applicationId String              @map("application_id")
  state         String              @default("ENABLED") // ENABLED, DISABLED, TRIAL
  validFrom     DateTime            @default(now()) @map("valid_from")
  validTo       DateTime?           @map("valid_to")
  createdAt     DateTime            @default(now()) @map("created_at")

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application   ApplicationRegistry @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, applicationId])
  @@index([applicationId])
  @@index([state])
  @@map("tenant_applications")
}

// A platform user's time-limited access into a tenant
// A platform user's time-limited access to one tenant's data (lib/support.ts).
// Without an active session, platform users can't work inside a tenant at all.
// Requested with a reason, approved by someone else with support:manage
// (unless SUPPORT_SELF_APPROVAL is on), read-only unless approved otherwise,
// and visible to the tenant (audit log and notifications).
model SupportSession {
  id              String               @id @default(uuid())
  platformUserId  String               @map("platform_user_id")
  tenantId        String               @map("tenant_id")
  approvedBy      String?              @map("approved_by")
  approvedAt      DateTime?            @map("approved_at")
  reason          String
  access          SupportAccess        @default(READ_ONLY)
  /// READ_WRITE: the tenant permissions granted (reading is always included)
  permissions     Json
  /// How long the session lasts once approved
  durationMinutes Int                  @default(60) @map("duration_minutes")
  validFrom       DateTime?            @map("valid_from")
  validTo         DateTime?            @map("valid_to")
  status          SupportSessionStatus @default(PENDING)
  decisionNote    String?              @map("decision_note")
  revokedAt       DateTime?            @map("revoked_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  platformUser    PlatformUser  @relation("SupportPlatformUser", fields: [platformUserId], references: [id], onDelete: Cascade)
  approver        PlatformUser? @relation("SupportApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([platformUserId, tenantId, status])
  @@map("support_sessions")
}

enum SupportAccess {
  READ_ONLY
  READ_WRITE
}

enum SupportSessionStatus {
  PENDING
  ACTIVE
  REJECTED
  REVOKED
  EXPIRED
}

// Platform roles: sets of platform permissions given to platform users, on
// top of what their user type grants (utils/authorization.ts). Only platform
// permissions can be in them; built-in roles (isSystem) are kept up to date
// at start-up and can't be edited.
model PlatformRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[]
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  assignments PlatformRoleAssignment[]

  @@map("platform_roles")
}

model PlatformRoleAssignment {
  id             String       @id @default(uuid())
  platformUserId String       @map("platform_user_id")
  roleId         String       @map("role_id")
  assignedBy     String?      @map("assigned_by")
  createdAt      DateTime     @default(now()) @map("created_at")

  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  role           PlatformRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([platformUserId, roleId])
  @@index([roleId])
  @@map("platform_role_assignments")
}

// Database-driven navigation for both portals
model MenuItem {
  id          String     @id @default(uuid())
  portal      String     // PLATFORM, TENANT
  parentId    String?    @map("parent_id")
  label       String
  path        String
  icon        String?
  permission  String?
  order       Int        @default(0)
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  parent      MenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    MenuItem[] @relation("MenuHierarchy")

  @@index([portal, isActive, order])
  @@index([parentId])
  @@map("menu_items")
}

// Audit log of platform actions (src/lib/audit.ts): the same shape and hash
// chain as each tenant's audit_events, as one chain ("platform").
model PlatformAuditEvent {
  id            String         @id @default(uuid())
  /// The tenant the action concerned, if any
  tenantId      String?        @map("tenant_id")
  seq           Int            @unique
  occurredAt    DateTime       @default(now()) @map("occurred_at")
  event         String
  category      String
  outcome       AuditOutcome   @default(SUCCESS)
  actorType     AuditActorType @map("actor_type")
  actorId       String?        @map("actor_id")
  actorEmail    String?        @map("actor_email")
  resourceType  String?        @map("resource_type")
  resourceId    String?        @map("resource_id")
  resourceLabel String?        @map("resource_label")
  changes       Json?
  details       Json?
  ip            String?
  userAgent     String?        @map("user_agent")
  requestId     String?        @map("request_id")
  prevHash      String         @map("prev_hash")
  hash          String
  keyVersion    Int            @map("key_version")

  @@index([occurredAt])
  @@index([tenantId])
  @@index([event])
  @@map("platform_audit_events")
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

enum AuditActorType {
  USER
  PLATFORM
  SYSTEM
  ANONYMOUS
}

// The latest entry of each audit chain ("platform" or a tenant id), kept
// apart from the tenant's own data: removing entries from the end of a
// tenant's chain is then detectable too.
model AuditHead {
  chain     String   @id
  seq       Int
  hash      String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("audit_heads")
}

// Audit entries moved out of the live tables after the retention period:
// one gzipped JSON-lines file per run and chain, with what's needed to keep
// verifying the chain across it.
model AuditArchive {
  id        String   @id @default(uuid())
  chain     String
  tenantId  String?  @map("tenant_id")
  fromSeq   Int      @map("from_seq")
  toSeq     Int      @map("to_seq")
  fromAt    DateTime @map("from_at")
  toAt      DateTime @map("to_at")
  rows      Int
  /// prev_hash of the first entry and hash of the last
  firstPrevHash String @map("first_prev_hash")
  lastHash  String   @map("last_hash")
  /// Path under AUDIT_ARCHIVE_DIR
  file      String
  sha256    String
  bytes     Int
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([chain, fromSeq])
  @@index([tenantId])
  @@map("audit_archives")
}

// Platform users' notifications: the same shapes as the tenant plane's
// (prisma/tenant/kit/notifications.prisma), without the tenant.
model PlatformNotification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  title     String
  body      String?
  link      String?
  data      Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("platform_notifications")
}

model PlatformNotificationOutbox {
  id            String                   @id @default(uuid())
  kind          NotificationOutboxKind
  status        NotificationOutboxStatus @default(PENDING)
  payload       Json
  attempts      Int                      @default(0)
  nextAttemptAt DateTime                 @default(now()) @map("next_attempt_at")
  claimedAt     DateTime?                @map("claimed_at")
  lastError     String?                  @map("last_error")
  createdAt     DateTime                 @default(now()) @map("created_at")

  @@index([status, nextAttemptAt])
  @@map("platform_notification_outbox")
}

enum NotificationOutboxKind {
  EVENT
  EMAIL
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  FAILED
}

model PlatformNotificationPreference {
  id     String  @id @default(uuid())
  userId String  @map("user_id")
  type   String
  inApp  Boolean @map("in_app")
  email  Boolean

  @@unique([userId, type])
  @@map("platform_notification_preferences")
}

// Which tenants (or "platform") have notification work due, so the worker
// only visits those instead of every tenant database.
model NotificationWork {
  chain     String   @id
  dueAt     DateTime @map("due_at")

  @@index([dueAt])
  @@map("notification_work")
}

// Request counters for the rate limits that must hold across every server
// (sign-in, one-time and two-factor codes): lib/rate-limit-store.ts. The key
// is a hash, so no email addresses are stored here.
model RateLimitHit {
  key       String   @id
  count     Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("rate_limit_hits")
}
