// Prisma schema for multi-tenant application management
// Supports three isolation strategies: Database per Tenant, Schema per Tenant, Shared Tables
// Uses snake_case for database tables and columns via @map and @@map

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Tenant model - represents each customer/organization
model Tenant {
  id              String    @id @default(uuid())
  name            String
  slug            String    @unique
  plan            TenantPlan
  status          TenantStatus
  
  // Branding
  logoUrl         String?   @map("logo_url")
  primaryColor    String?   @default("#3b82f6") @map("primary_color")
  customDomain    String?   @unique @map("custom_domain")
  loginTitle      String?   @map("login_title")
  loginSubtitle   String?   @map("login_subtitle")
  
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  // Relations
  users           User[]
  applications    Application[]
  databaseConfig  DatabaseConfig?
  authConfig      AuthConfig?
  apiConfig       ApiConfig?
  activities      Activity[]
  roles           Role[]
  
  @@map("tenants")
  @@index([slug])
  @@index([status])
}

enum TenantPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

// User model - users belong to a tenant
model User {
  id              String     @id @default(uuid())
  tenantId        String?    @map("tenant_id") // Nullable for platform users
  email           String
  name            String?
  passwordHash    String?    @map("password_hash")
  userType        UserType   @default(TENANT_USER) @map("user_type")
  status          UserStatus @default(ACTIVE)
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  
  // Relations
  tenant          Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles           UserRole[]
  
  @@map("users")
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@index([userType])
}

enum UserType {
  PLATFORM_ADMIN
  PLATFORM_USER
  TENANT_ADMIN
  TENANT_MANAGER
  TENANT_USER
  TENANT_DEVELOPER
  TENANT_VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

// Application model - applications belong to a tenant
model Application {
  id              String            @id @default(uuid())
  tenantId        String            @map("tenant_id")
  name            String
  description     String?
  status          ApplicationStatus
  version         String
  environment     Environment
  url             String
  cpu             Int               @default(0)
  memory          Int               @default(0)
  requests        Int               @default(0)
  lastDeployedAt  DateTime?         @map("last_deployed_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  
  // Relations
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@map("applications")
  @@index([tenantId])
  @@index([status])
  @@index([environment])
}

enum ApplicationStatus {
  RUNNING
  STOPPED
  DEPLOYING
  ERROR
}

enum Environment {
  PRODUCTION
  STAGING
  DEVELOPMENT
}

// Database configuration per tenant
model DatabaseConfig {
  id                String            @id @default(uuid())
  tenantId          String            @unique @map("tenant_id")
  strategy          DatabaseStrategy
  provider          DatabaseProvider
  region            String
  backupEnabled     Boolean           @default(false) @map("backup_enabled")
  encryptionAtRest  Boolean           @default(false) @map("encryption_at_rest")
  maxConnections    Int               @default(100) @map("max_connections")
  storageLimit      String            @map("storage_limit")
  connectionString  String?           @map("connection_string")
  schemaName        String?           @map("schema_name")
  tenantColumn      String?           @map("tenant_column")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  
  // Relations
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@map("database_configs")
}

enum DatabaseStrategy {
  DATABASE_PER_TENANT
  SCHEMA_PER_TENANT
  SHARED_TABLES
}

enum DatabaseProvider {
  POSTGRESQL
  MYSQL
  MONGODB
  SQLSERVER
}

// Authentication configuration per tenant
model AuthConfig {
  id              String         @id @default(uuid())
  tenantId        String         @unique @map("tenant_id")
  mfaEnabled      Boolean        @default(false) @map("mfa_enabled")
  sessionTimeout  Int            @default(60) @map("session_timeout")
  passwordPolicy  PasswordPolicy @default(STANDARD) @map("password_policy")
  ssoOnly         Boolean        @default(false) @map("sso_only")
  otpEnabled      Boolean        @default(true) @map("otp_enabled")
  otpExpiry       Int            @default(5) @map("otp_expiry")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  
  // Relations
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providers       AuthProvider[]
  
  @@map("auth_configs")
}

enum PasswordPolicy {
  STANDARD
  STRONG
  VERY_STRONG
}

// Authentication providers per tenant
model AuthProvider {
  id              String           @id @default(uuid())
  authConfigId    String           @map("auth_config_id")
  provider        AuthProviderType
  enabled         Boolean          @default(false)
  clientId        String?          @map("client_id")
  clientSecret    String?          @map("client_secret")
  tenantId        String?          @map("tenant_id")
  domain          String?
  scopes          String[]
  autoProvision   Boolean          @default(false) @map("auto_provision")
  
  // OAuth configuration
  authorizeUrl    String?          @map("authorize_url")
  tokenUrl        String?          @map("token_url")
  userInfoUrl     String?          @map("user_info_url")
  
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  
  // Relations
  authConfig      AuthConfig       @relation(fields: [authConfigId], references: [id], onDelete: Cascade)
  
  @@map("auth_providers")
  @@index([authConfigId])
}

enum AuthProviderType {
  ENTRA
  GOOGLE
  GITHUB
  OKTA
  AUTH0
  CUSTOM_OIDC
}

// API configuration per tenant
model ApiConfig {
  id              String         @id @default(uuid())
  tenantId        String         @unique @map("tenant_id")
  bffEnabled      Boolean        @default(false) @map("bff_enabled")
  bffUrl          String?        @map("bff_url")
  apiGateway      ApiGateway     @map("api_gateway")
  rateLimit       Int            @default(5000) @map("rate_limit")
  corsEnabled     Boolean        @default(true) @map("cors_enabled")
  allowedOrigins  String[]       @map("allowed_origins")
  authType        ApiAuthType    @default(JWT) @map("auth_type")
  versioning      ApiVersioning  @default(URL)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  
  // Relations
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@map("api_configs")
}

enum ApiGateway {
  KONG
  APIGEE
  AWS_APIGATEWAY
  AZURE_APIM
  CUSTOM
}

enum ApiAuthType {
  JWT
  OAUTH2
  API_KEY
}

enum ApiVersioning {
  URL
  HEADER
  QUERY
}

// Activity log for audit trail
model Activity {
  id          String       @id @default(uuid())
  tenantId    String       @map("tenant_id")
  userId      String?      @map("user_id")
  action      String
  target      String
  type        ActivityType
  metadata    Json?
  createdAt   DateTime     @default(now()) @map("created_at")
  
  // Relations
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@map("activities")
  @@index([tenantId])
  @@index([type])
  @@index([createdAt])
}

enum ActivityType {
  DEPLOY
  CONFIG
  USER
  BILLING
  ALERT
  AUTH
  API
}

// OAuth session state for secure OAuth flow
model OAuthSession {
  id            String    @id @default(uuid())
  state         String    @unique
  providerId    String    @map("provider_id")
  tenantId      String    @map("tenant_id")
  redirectUri   String    @map("redirect_uri")
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  
  @@map("oauth_sessions")
  @@index([state])
  @@index([expiresAt])
}

// OTP codes for passwordless authentication
model OtpCode {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  email       String
  code        String
  expiresAt   DateTime  @map("expires_at")
  verified    Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  
  @@index([tenantId, email, code])
  @@index([expiresAt])
  @@map("otp_codes")
}

// Refresh tokens for BFF session management
model RefreshToken {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  tenantId      String    @map("tenant_id")
  token         String    @unique
  familyId      String    @map("family_id") // For token rotation detection
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  userAgent     String?   @map("user_agent")
  ipAddress     String?   @map("ip_address")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  
  @@index([userId])
  @@index([token])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// Permission model - defines granular permissions
model Permission {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  resource    String    // e.g., "tenants", "applications", "users"
  action      String    // e.g., "create", "read", "update", "delete"
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  roles       RolePermission[]
  
  @@map("permissions")
  @@index([resource, action])
}

// Role model - custom roles per tenant
model Role {
  id          String    @id @default(uuid())
  tenantId    String?   @map("tenant_id") // Null for platform roles
  name        String
  description String?
  isSystem    Boolean   @default(false) @map("is_system") // System roles can't be deleted
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  // Relations
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]
  
  @@unique([tenantId, name])
  @@map("roles")
  @@index([tenantId])
}

// Role-Permission mapping (many-to-many)
model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  
  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// User-Role mapping (many-to-many)
model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  @@unique([userId, roleId])
  @@map("user_roles")
}
