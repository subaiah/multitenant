// Prisma schema for multi-tenant application management
// Supports three isolation strategies: Database per Tenant, Schema per Tenant, Shared Tables
// Uses snake_case for database tables and columns via @map and @@map

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Tenant model - represents each customer/organization
model Tenant {
  id              String    @id @default(uuid())
  name            String
  slug            String    @unique
  plan            TenantPlan
  status          TenantStatus
  
  // Branding
  logoUrl         String?   @map("logo_url")
  primaryColor    String?   @default("#3b82f6") @map("primary_color")
  customDomain    String?   @unique @map("custom_domain")
  loginTitle      String?   @map("login_title")
  loginSubtitle   String?   @map("login_subtitle")
  
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  // Relations
  users           User[]
  applications    Application[]
  databaseConfig  DatabaseConfig?
  authConfig      AuthConfig?
  apiConfig       ApiConfig?
  activities      Activity[]
  roles           Role[]
  groups          Group[]
  groupMemberships GroupMembership[]
  roleAssignments RoleAssignment[]
  organizations   Organization[]
  orgUnits        OrgUnit[]
  orgMemberships  OrgMembership[]
  tenantApplications TenantApplication[]
  
  // Phase 3 relations
  delegations     Delegation[]
  accessPolicies  AccessPolicy[]
  supportSessions SupportSession[]
  accessRequests  AccessRequest[]
  certifications  AccessCertification[]
  
  @@map("tenants")
  @@index([slug])
  @@index([status])
}

enum TenantPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

// User model - users belong to a tenant
model User {
  id              String     @id @default(uuid())
  tenantId        String?    @map("tenant_id") // Nullable for platform users
  email           String
  name            String?
  passwordHash    String?    @map("password_hash")
  userType        UserType   @default(TENANT_USER) @map("user_type")
  status          UserStatus @default(ACTIVE)
  lastLoginAt     DateTime?  @map("last_login_at")
  /// Access tokens issued before this are refused ("sign out everywhere")
  sessionsValidAfter DateTime? @map("sessions_valid_after")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  
  // Relations
  tenant          Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles           UserRole[]
  groupMemberships GroupMembership[]
  roleAssignments RoleAssignment[]
  orgMemberships  OrgMembership[]
  
  // Phase 3 relations
  delegationsAsDelegator Delegation[] @relation("Delegator")
  delegationsAsDelegate  Delegation[] @relation("Delegate")
  supportSessionsAsPlatformUser SupportSession[] @relation("SupportPlatformUser")
  supportSessionsAsApprover     SupportSession[] @relation("SupportApprover")
  accessRequestsAsRequester     AccessRequest[] @relation("AccessRequester")
  accessRequestsAsApprover      AccessRequest[] @relation("AccessApprover")
  certificationsAsReviewer      AccessCertification[] @relation("CertificationReviewer")
  tokens                        UserToken[]
  
  @@map("users")
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@index([userType])
}

enum UserType {
  PLATFORM_ADMIN
  PLATFORM_USER
  TENANT_ADMIN
  TENANT_MANAGER
  TENANT_USER
  TENANT_DEVELOPER
  TENANT_VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

// Application model - applications belong to a tenant
model Application {
  id              String            @id @default(uuid())
  tenantId        String            @map("tenant_id")
  name            String
  description     String?
  status          ApplicationStatus
  version         String
  environment     Environment
  url             String
  cpu             Int               @default(0)
  memory          Int               @default(0)
  requests        Int               @default(0)
  lastDeployedAt  DateTime?         @map("last_deployed_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  
  // Relations
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@map("applications")
  @@index([tenantId])
  @@index([status])
  @@index([environment])
}

enum ApplicationStatus {
  RUNNING
  STOPPED
  DEPLOYING
  ERROR
}

enum Environment {
  PRODUCTION
  STAGING
  DEVELOPMENT
}

// Database configuration per tenant
model DatabaseConfig {
  id                String            @id @default(uuid())
  tenantId          String            @unique @map("tenant_id")
  strategy          DatabaseStrategy
  provider          DatabaseProvider
  region            String
  backupEnabled     Boolean           @default(false) @map("backup_enabled")
  encryptionAtRest  Boolean           @default(false) @map("encryption_at_rest")
  maxConnections    Int               @default(100) @map("max_connections")
  storageLimit      String            @map("storage_limit")
  connectionString  String?           @map("connection_string")
  schemaName        String?           @map("schema_name")
  tenantColumn      String?           @map("tenant_column")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  
  // Relations
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@map("database_configs")
}

enum DatabaseStrategy {
  DATABASE_PER_TENANT
  SCHEMA_PER_TENANT
  SHARED_TABLES
}

enum DatabaseProvider {
  POSTGRESQL
  MYSQL
  MONGODB
  SQLSERVER
}

// Authentication configuration per tenant
model AuthConfig {
  id              String         @id @default(uuid())
  tenantId        String         @unique @map("tenant_id")
  mfaEnabled      Boolean        @default(false) @map("mfa_enabled")
  sessionTimeout  Int            @default(60) @map("session_timeout")
  passwordPolicy  PasswordPolicy @default(STANDARD) @map("password_policy")
  ssoOnly         Boolean        @default(false) @map("sso_only")
  otpEnabled      Boolean        @default(true) @map("otp_enabled")
  otpExpiry       Int            @default(5) @map("otp_expiry")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  
  // Relations
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providers       AuthProvider[]
  
  @@map("auth_configs")
}

enum PasswordPolicy {
  STANDARD
  STRONG
  VERY_STRONG
}

// Authentication providers per tenant
model AuthProvider {
  id              String           @id @default(uuid())
  authConfigId    String           @map("auth_config_id")
  provider        AuthProviderType
  enabled         Boolean          @default(false)
  clientId        String?          @map("client_id")
  clientSecret    String?          @map("client_secret")
  tenantId        String?          @map("tenant_id")
  domain          String?
  scopes          String[]
  autoProvision   Boolean          @default(false) @map("auto_provision")
  
  // OAuth configuration
  authorizeUrl    String?          @map("authorize_url")
  tokenUrl        String?          @map("token_url")
  userInfoUrl     String?          @map("user_info_url")
  
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  
  // Relations
  authConfig      AuthConfig       @relation(fields: [authConfigId], references: [id], onDelete: Cascade)
  
  @@map("auth_providers")
  @@index([authConfigId])
}

enum AuthProviderType {
  ENTRA
  GOOGLE
  GITHUB
  OKTA
  AUTH0
  CUSTOM_OIDC
}

// API configuration per tenant
model ApiConfig {
  id              String         @id @default(uuid())
  tenantId        String         @unique @map("tenant_id")
  bffEnabled      Boolean        @default(false) @map("bff_enabled")
  bffUrl          String?        @map("bff_url")
  apiGateway      ApiGateway     @map("api_gateway")
  rateLimit       Int            @default(5000) @map("rate_limit")
  corsEnabled     Boolean        @default(true) @map("cors_enabled")
  allowedOrigins  String[]       @map("allowed_origins")
  authType        ApiAuthType    @default(JWT) @map("auth_type")
  versioning      ApiVersioning  @default(URL)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  
  // Relations
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@map("api_configs")
}

enum ApiGateway {
  KONG
  APIGEE
  AWS_APIGATEWAY
  AZURE_APIM
  CUSTOM
}

enum ApiAuthType {
  JWT
  OAUTH2
  API_KEY
}

enum ApiVersioning {
  URL
  HEADER
  QUERY
}

// Activity log for audit trail
model Activity {
  id          String       @id @default(uuid())
  tenantId    String?      @map("tenant_id") // Null for platform-level actions
  userId      String?      @map("user_id")
  action      String
  target      String
  type        ActivityType
  metadata    Json?
  createdAt   DateTime     @default(now()) @map("created_at")
  
  // Relations
  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@map("activities")
  @@index([tenantId])
  @@index([type])
  @@index([createdAt])
}

enum ActivityType {
  DEPLOY
  CONFIG
  USER
  BILLING
  ALERT
  AUTH
  API
}

// Single-use tokens emailed to users (invitations, password resets).
// Only a SHA-256 hash of the token is stored.
model UserToken {
  id         String        @id @default(uuid())
  userId     String        @map("user_id")
  type       UserTokenType
  tokenHash  String        @unique @map("token_hash")
  expiresAt  DateTime      @map("expires_at")
  usedAt     DateTime?     @map("used_at")
  createdById String?      @map("created_by_id")
  createdAt  DateTime      @default(now()) @map("created_at")

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_tokens")
  @@index([userId, type])
}

enum UserTokenType {
  INVITE
  PASSWORD_RESET
}

// OAuth session state for secure OAuth flow
model OAuthSession {
  id            String    @id @default(uuid())
  state         String    @unique
  providerId    String    @map("provider_id")
  tenantId      String    @map("tenant_id")
  redirectUri   String    @map("redirect_uri")
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  
  @@map("oauth_sessions")
  @@index([state])
  @@index([expiresAt])
}

// Group model for managing collections of users
model Group {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  groupType   String   @default("MANUAL") @map("group_type") // MANUAL, SYNCED, RULE_BASED
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  // Relations
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members     GroupMembership[]
  roleAssignments RoleAssignment[]
  
  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([status])
  @@map("groups")
}

// Group membership - links users to groups
model GroupMembership {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  groupId   String    @map("group_id")
  userId    String    @map("user_id")
  validFrom DateTime  @default(now()) @map("valid_from")
  validTo   DateTime? @map("valid_to")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  
  // Relations
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, groupId, userId])
  @@index([tenantId, userId])
  @@index([groupId])
  @@index([validFrom, validTo])
  @@map("group_memberships")
}

// OTP codes for passwordless authentication
model OtpCode {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  email       String
  code        String
  expiresAt   DateTime  @map("expires_at")
  verified    Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  
  @@index([tenantId, email, code])
  @@index([expiresAt])
  @@map("otp_codes")
}

// Refresh tokens for BFF session management
model RefreshToken {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  tenantId      String?   @map("tenant_id") // Null for platform users
  token         String    @unique
  familyId      String    @map("family_id") // For token rotation detection
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  userAgent     String?   @map("user_agent")
  ipAddress     String?   @map("ip_address")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  
  @@index([userId])
  @@index([token])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// Permission model - defines granular permissions
model Permission {
  id            String    @id @default(uuid())
  applicationId String?   @map("application_id") // Link to application registry if app-specific
  name          String    @unique
  description   String?
  resource      String    // e.g., "tenants", "applications", "users"
  action        String    // e.g., "create", "read", "update", "delete"
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  
  // Relations
  application   ApplicationRegistry? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  roles         RolePermission[]
  
  @@map("permissions")
  @@index([applicationId])
  @@index([resource, action])
}

// Role model - custom roles per tenant
model Role {
  id          String    @id @default(uuid())
  tenantId    String?   @map("tenant_id") // Null for platform roles
  name        String
  description String?
  isSystem    Boolean   @default(false) @map("is_system") // System roles can't be deleted
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  // Relations
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]
  roleAssignments RoleAssignment[]
  
  // Phase 3 relations
  accessRequests AccessRequest[]
  
  @@unique([tenantId, name])
  @@map("roles")
  @@index([tenantId])
}

// Role-Permission mapping (many-to-many)
model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  
  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// Organization - represents a legal/operating entity within a tenant
model Organization {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  // Relations
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  units       OrgUnit[]
  memberships OrgMembership[]
  
  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([status])
  @@map("organizations")
}

// OrgUnit - recursive organizational structure (divisions, departments, teams, locations)
model OrgUnit {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  organizationId String    @map("organization_id")
  parentUnitId   String?   @map("parent_unit_id")
  unitType       String    @map("unit_type") // DIVISION, DEPARTMENT, TEAM, LOCATION
  name           String
  description    String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  
  // Relations
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         OrgUnit?  @relation("OrgUnitHierarchy", fields: [parentUnitId], references: [id])
  children       OrgUnit[] @relation("OrgUnitHierarchy")
  memberships    OrgMembership[]
  
  @@index([tenantId, organizationId])
  @@index([parentUnitId])
  @@index([unitType])
  @@map("org_units")
}

// OrgMembership - user's affiliation with organization/unit
model OrgMembership {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  userId         String   @map("user_id")
  organizationId String?  @map("organization_id")
  orgUnitId      String?  @map("org_unit_id")
  createdAt      DateTime @default(now()) @map("created_at")
  
  // Relations
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orgUnit        OrgUnit? @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, userId, organizationId, orgUnitId])
  @@index([tenantId, userId])
  @@index([organizationId])
  @@index([orgUnitId])
  @@map("org_memberships")
}

// ApplicationRegistry - platform-wide catalog of available applications
model ApplicationRegistry {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  version     String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  // Relations
  permissions Permission[]
  tenantApplications TenantApplication[]
  
  @@index([key])
  @@index([status])
  @@map("application_registries")
}

// TenantApplication - tenant's entitlement to use an application
model TenantApplication {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  applicationId String   @map("application_id")
  state         String   @default("ENABLED") // ENABLED, DISABLED, TRIAL
  validFrom     DateTime @default(now()) @map("valid_from")
  validTo       DateTime? @map("valid_to")
  createdAt     DateTime @default(now()) @map("created_at")
  
  // Relations
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application   ApplicationRegistry @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, applicationId])
  @@index([tenantId])
  @@index([applicationId])
  @@index([state])
  @@map("tenant_applications")
}

// Role Assignment - enhanced with scope and principal type support
model RoleAssignment {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  roleId        String    @map("role_id")
  principalType String    @map("principal_type") // USER, GROUP
  userId        String?   @map("user_id")
  groupId       String?   @map("group_id")
  scopeType     String    @default("TENANT") @map("scope_type") // TENANT, ORGANIZATION, ORG_UNIT, RESOURCE
  scopeId       String    @map("scope_id")
  validFrom     DateTime  @default(now()) @map("valid_from")
  validTo       DateTime? @map("valid_to")
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  
  // Relations
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role          Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group         Group?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  
  // Phase 3 relations
  delegations   Delegation[]
  certificationDecisions CertificationDecision[]
  
  // Indexes for efficient queries
  @@index([tenantId, userId, status])
  @@index([tenantId, groupId, status])
  @@index([roleId])
  @@index([scopeType, scopeId])
  @@index([validFrom, validTo])
  @@map("role_assignments")
}

// Legacy UserRole model - kept for backward compatibility during migration
model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  @@unique([userId, roleId])
  @@map("user_roles")
}

// ============================================
// Phase 3: Advanced Governance Models
// ============================================

// Delegation - temporary access delegation
model Delegation {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  delegatorId          String    @map("delegator_id")
  delegateId           String    @map("delegate_id")
  roleAssignmentId     String    @map("role_assignment_id")
  reason               String?
  validFrom            DateTime  @default(now()) @map("valid_from")
  validTo              DateTime  @map("valid_to")
  status               String    @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  revokedAt            DateTime? @map("revoked_at")
  revokedBy            String?   @map("revoked_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  
  // Relations
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  delegator            User      @relation("Delegator", fields: [delegatorId], references: [id], onDelete: Cascade)
  delegate             User      @relation("Delegate", fields: [delegateId], references: [id], onDelete: Cascade)
  roleAssignment       RoleAssignment @relation(fields: [roleAssignmentId], references: [id], onDelete: Cascade)
  
  @@index([tenantId, delegateId, status])
  @@index([delegatorId])
  @@index([validFrom, validTo])
  @@map("delegations")
}

// Access Policy - ABAC conditions
model AccessPolicy {
  id          String   @id @default(uuid())
  tenantId    String?  @map("tenant_id") // NULL for platform policies
  name        String
  description String?
  effect      String   // ALLOW, DENY
  conditions  Json     // ABAC conditions in JSON format
  priority    Int      @default(0) // Higher priority = evaluated first
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  // Relations
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bindings    PolicyBinding[]
  
  @@index([tenantId, enabled, priority])
  @@map("access_policies")
}

// Policy Binding - where policies apply
model PolicyBinding {
  id          String   @id @default(uuid())
  policyId    String   @map("policy_id")
  scopeType   String   @map("scope_type") // TENANT, ORGANIZATION, ORG_UNIT, RESOURCE
  scopeId     String   @map("scope_id")
  createdAt   DateTime @default(now()) @map("created_at")
  
  // Relations
  policy      AccessPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  
  @@unique([policyId, scopeType, scopeId])
  @@index([scopeType, scopeId])
  @@map("policy_bindings")
}

// Support Session - platform-to-tenant access
model SupportSession {
  id              String    @id @default(uuid())
  platformUserId  String    @map("platform_user_id")
  tenantId        String    @map("tenant_id")
  approvedBy      String    @map("approved_by")
  reason          String
  permissions     Json      // Specific permissions granted
  validFrom       DateTime  @default(now()) @map("valid_from")
  validTo         DateTime  @map("valid_to")
  status          String    @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  // Relations
  platformUser    User      @relation("SupportPlatformUser", fields: [platformUserId], references: [id], onDelete: Cascade)
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approver        User      @relation("SupportApprover", fields: [approvedBy], references: [id], onDelete: Cascade)
  
  @@index([tenantId, status])
  @@index([platformUserId])
  @@index([validFrom, validTo])
  @@map("support_sessions")
}

// Access Request - Just-in-Time access requests
model AccessRequest {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  requesterId     String    @map("requester_id")
  approverId      String?   @map("approver_id")
  roleId          String    @map("role_id")
  scopeType       String    @map("scope_type")
  scopeId         String    @map("scope_id")
  reason          String
  duration        Int       // Duration in hours
  status          String    @default("PENDING") // PENDING, APPROVED, DENIED, EXPIRED
  approvedAt      DateTime? @map("approved_at")
  deniedAt        DateTime? @map("denied_at")
  denialReason    String?   @map("denial_reason")
  validFrom       DateTime? @map("valid_from")
  validTo         DateTime? @map("valid_to")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  // Relations
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requester       User      @relation("AccessRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  approver        User?     @relation("AccessApprover", fields: [approverId], references: [id], onDelete: Cascade)
  role            Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  @@index([tenantId, status])
  @@index([requesterId])
  @@index([approverId])
  @@map("access_requests")
}

// Access Certification - periodic access reviews
model AccessCertification {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  name            String
  description     String?
  reviewType      String    @map("review_type") // ROLE, PERMISSION, ORGANIZATION
  scopeType       String    @map("scope_type")
  scopeId         String    @map("scope_id")
  reviewerId      String    @map("reviewer_id")
  dueDate         DateTime  @map("due_date")
  status          String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, OVERDUE
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  // Relations
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviewer        User      @relation("CertificationReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  decisions       CertificationDecision[]
  
  @@index([tenantId, status, dueDate])
  @@index([reviewerId])
  @@map("access_certifications")
}

// Certification Decision - individual decisions in a certification
model CertificationDecision {
  id                  String    @id @default(uuid())
  certificationId     String    @map("certification_id")
  roleAssignmentId    String    @map("role_assignment_id")
  decision            String    // APPROVE, REVOKE
  reason              String?
  decidedAt           DateTime  @default(now()) @map("decided_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  
  // Relations
  certification       AccessCertification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  roleAssignment      RoleAssignment @relation(fields: [roleAssignmentId], references: [id], onDelete: Cascade)
  
  @@unique([certificationId, roleAssignmentId])
  @@map("certification_decisions")
}

// MenuItem - database-driven navigation menu items
model MenuItem {
  id              String    @id @default(uuid())
  portal          String    // PLATFORM, TENANT
  parentId        String?   @map("parent_id")
  label           String
  path            String
  icon            String?   // Icon name (e.g., "dashboard", "users")
  permission      String?   // Required permission to show this item
  order           Int       @default(0)
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  // Relations
  parent          MenuItem? @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children        MenuItem[] @relation("MenuHierarchy")
  
  @@index([portal, isActive, order])
  @@index([parentId])
  @@map("menu_items")
}
