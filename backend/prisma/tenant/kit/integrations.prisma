// Other systems working with the organization (docs/API_ACCESS.md): API keys
// they call the API with, and webhooks the platform calls them with.

// A key for calling the API as the organization (lib/api-keys.ts). Only a
// hash of its secret is kept; the key is shown once, when it's made.
model ApiKey {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  name           String
  /// The key's last characters, to tell keys apart in lists
  hint           String
  /// SHA-256 of the secret part
  secretHash     String    @map("secret_hash")
  /// What the key may do: a subset of what its maker could do when making it
  permissions    String[]
  /// The maker's user type then (the same rules as for people apply to what it manages)
  userType       UserType  @map("user_type")
  createdById    String?   @map("created_by_id")
  createdByEmail String?   @map("created_by_email")
  expiresAt      DateTime? @map("expires_at")
  lastUsedAt     DateTime? @map("last_used_at")
  lastUsedIp     String?   @map("last_used_ip")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([tenantId, revokedAt])
  @@map("api_keys")
}

// Where to send the organization's events (lib/webhooks.ts)
model WebhookEndpoint {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  url                 String
  description         String?
  /// Audit event types to send; ["*"] for all
  events              String[]
  enabled             Boolean   @default(true)
  /// The signing secret (whsec_...), encrypted at rest (lib/secrets.ts)
  signingSecret       String    @map("signing_secret")
  createdById         String?   @map("created_by_id")
  lastSuccessAt       DateTime? @map("last_success_at")
  lastFailureAt       DateTime? @map("last_failure_at")
  /// Deliveries that failed in a row (any success resets it)
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  /// Why it was turned off by the platform (too many failures), if it was
  disabledReason      String?   @map("disabled_reason")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  deliveries          WebhookDelivery[]

  @@index([tenantId, enabled])
  @@map("webhook_endpoints")
}

enum WebhookDeliveryStatus {
  PENDING
  SENDING
  DELIVERED
  FAILED
}

// One event for one endpoint: retried with backoff until it's taken (2xx) or given up on
model WebhookDelivery {
  id             String                @id @default(uuid())
  tenantId       String                @map("tenant_id")
  endpointId     String                @map("endpoint_id")
  /// The event's id: the same for every endpoint and every retry (webhook-id)
  eventId        String                @map("event_id")
  type           String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime              @default(now()) @map("next_attempt_at")
  claimedAt      DateTime?             @map("claimed_at")
  responseStatus Int?                  @map("response_status")
  lastError      String?               @map("last_error")
  durationMs     Int?                  @map("duration_ms")
  deliveredAt    DateTime?             @map("delivered_at")
  createdAt      DateTime              @default(now()) @map("created_at")

  endpoint       WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, nextAttemptAt])
  @@index([tenantId, endpointId, createdAt])
  @@map("webhook_deliveries")
}
