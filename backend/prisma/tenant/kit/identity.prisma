// Tenant users, how they sign in, and their sessions

model User {
  id                 String     @id @default(uuid())
  tenantId           String     @map("tenant_id")
  email              String
  name               String?
  passwordHash       String?    @map("password_hash")
  userType           UserType   @default(TENANT_USER) @map("user_type")
  status             UserStatus @default(ACTIVE)
  lastLoginAt        DateTime?  @map("last_login_at")
  /// Access tokens issued before this are refused ("sign out everywhere")
  sessionsValidAfter DateTime?  @map("sessions_valid_after")
  /// Two-factor sign-in (lib/mfa.ts). The TOTP secret is encrypted at rest (lib/secrets.ts).
  totpSecret         String?    @map("totp_secret")
  mfaEnabledAt       DateTime?  @map("mfa_enabled_at")
  /// SHA-256 hashes of unused recovery codes
  mfaRecoveryCodes   String[]   @default([]) @map("mfa_recovery_codes")
  /// Last TOTP time step accepted, so a code can't be used twice
  mfaLastStep        Int?       @map("mfa_last_step")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  externalIdentities     ExternalIdentity[]
  groupMemberships       GroupMembership[]
  roleAssignments        RoleAssignment[]
  orgMemberships         OrgMembership[]
  delegationsAsDelegator Delegation[]          @relation("Delegator")
  delegationsAsDelegate  Delegation[]          @relation("Delegate")
  accessRequests         AccessRequest[]       @relation("AccessRequester")
  accessApprovals        AccessRequest[]       @relation("AccessApprover")
  certificationsToReview AccessCertification[] @relation("CertificationReviewer")
  tokens                 UserToken[]

  @@unique([tenantId, email])
  @@index([tenantId, userType])
  @@map("users")
}

enum UserType {
  TENANT_ADMIN
  TENANT_MANAGER
  TENANT_USER
  TENANT_DEVELOPER
  TENANT_VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

model RefreshToken {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  userId     String    @map("user_id")
  token      String    @unique
  familyId   String    @map("family_id")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  /// When the session (token family) began; carried across rotations (maximum session length)
  sessionStartedAt DateTime @default(now()) @map("session_started_at")
  /// Last request seen in this session (idle timeout); updated at most once a minute
  lastSeenAt       DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// Single-use emailed tokens (invitations, password resets). Hash only.
model UserToken {
  id          String        @id @default(uuid())
  tenantId    String        @map("tenant_id")
  userId      String        @map("user_id")
  type        UserTokenType
  tokenHash   String        @unique @map("token_hash")
  expiresAt   DateTime      @map("expires_at")
  usedAt      DateTime?     @map("used_at")
  createdById String?       @map("created_by_id")
  /// EMAIL_CHANGE: the address being confirmed
  newEmail    String?       @map("new_email")
  createdAt   DateTime      @default(now()) @map("created_at")

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, type])
  @@map("user_tokens")
}

enum UserTokenType {
  INVITE
  PASSWORD_RESET
  // A new email address waiting for its owner to confirm it (new_email)
  EMAIL_CHANGE
}

model OtpCode {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  email      String
  code       String
  expiresAt  DateTime @map("expires_at")
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId, email, code])
  @@index([expiresAt])
  @@map("otp_codes")
}

// A single-sign-on attempt in progress (lib/sso.ts), between leaving for the
// identity provider and coming back. Single use, a few minutes long.
model OAuthSession {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  state        String   @unique
  providerId   String   @map("provider_id")
  /// Where to send the browser afterwards (a path in the frontend)
  redirectUri  String   @map("redirect_uri")
  /// PKCE verifier and OpenID nonce for this attempt
  codeVerifier String   @map("code_verifier")
  nonce        String?
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("oauth_sessions")
}

model AuthConfig {
  id              String         @id @default(uuid())
  tenantId        String         @unique @map("tenant_id")
  mfaEnabled      Boolean        @default(false) @map("mfa_enabled")
  /// Idle timeout in minutes: signed out after this long without activity
  sessionTimeout  Int            @default(60) @map("session_timeout")
  /// Maximum session length in hours: sign in again after this, however active
  maxSessionHours Int            @default(12) @map("max_session_hours")
  passwordPolicy  PasswordPolicy @default(STANDARD) @map("password_policy")
  ssoOnly         Boolean        @default(false) @map("sso_only")
  otpEnabled      Boolean        @default(true) @map("otp_enabled")
  otpExpiry       Int            @default(5) @map("otp_expiry")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  providers       AuthProvider[]

  @@map("auth_configs")
}

enum PasswordPolicy {
  STANDARD
  STRONG
  VERY_STRONG
}

model AuthProvider {
  id             String           @id @default(uuid())
  tenantId       String           @map("tenant_id")
  authConfigId   String           @map("auth_config_id")
  provider       AuthProviderType
  enabled        Boolean          @default(false)
  clientId       String?          @map("client_id")
  /// Encrypted at rest (lib/secrets.ts)
  clientSecret   String?          @map("client_secret")
  /// The identity provider's own directory / tenant id (e.g. Entra), not ours
  idpTenantId    String?          @map("idp_tenant_id")
  domain         String?
  scopes         String[]
  autoProvision  Boolean          @default(false) @map("auto_provision")
  authorizeUrl   String?          @map("authorize_url")
  tokenUrl       String?          @map("token_url")
  userInfoUrl    String?          @map("user_info_url")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  authConfig     AuthConfig       @relation(fields: [authConfigId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([authConfigId])
  @@map("auth_providers")
}

enum AuthProviderType {
  ENTRA
  GOOGLE
  GITHUB
  OKTA
  AUTH0
  CUSTOM_OIDC
}

// A user's account at an identity provider, linked on first single sign-on.
// Later sign-ins match on the provider's stable subject id, not the email,
// so a changed or recycled email at the provider can't take over an account.
model ExternalIdentity {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  userId     String   @map("user_id")
  providerId String   @map("provider_id")
  /// The provider's id for the person (OpenID `sub`, GitHub user id)
  subject    String
  email      String?
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, providerId, subject])
  @@index([userId])
  @@map("external_identities")
}
