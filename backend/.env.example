# Databases (see docs/tenant-isolation.md)
# Control plane: platform users, tenants and where each tenant's data lives.
# Schema: prisma/control (prisma.config.ts)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/multitenant"

# Tenant database server. Set it up once with prisma/tenant/setup-roles.sql,
# which creates these three roles and the shared tenant database:
# - migration owner: owns every tenant table, runs tenant migrations.
#   The shared tenant database (shared-tables tenants, and the schemas of
#   schema-per-tenant tenants). Must differ from DATABASE_URL.
TENANT_DATABASE_URL="postgresql://tenant_owner:change-me@localhost:5432/multitenant_tenants"
# - provisioner: creates and drops tenant roles and databases (any database on the server)
TENANT_PROVISIONER_URL="postgresql://tenant_provisioner:change-me@localhost:5432/postgres"
# - platform role: bypasses row-level security, for cross-tenant platform work
TENANT_PLATFORM_URL="postgresql://tenant_platform:change-me@localhost:5432/multitenant_tenants"
# Outside production the last two may be left out if TENANT_DATABASE_URL is a
# superuser (a throwaway local database); row-level security is still enforced
# for tenant requests, which always use the tenant's own role.

# Prefix of tenant role, schema and database names (role names are server-wide,
# so give each environment sharing a server its own, e.g. dev_, e2e_)
TENANT_ROLE_PREFIX=tnt_
# Each tenant role: connections per app server (pool) and in total (Postgres limit)
TENANT_POOL_MAX=3
TENANT_ROLE_CONNECTION_LIMIT=10
# Tenant clients kept open per app server (least recently used are closed)
TENANT_CLIENT_CACHE_MAX=100
# Platform usage snapshots (tenant list, platform dashboard): refresh interval in ms
TENANT_USAGE_REFRESH_MS=300000

# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Proxies in front of the server whose X-Forwarded-For it believes: how many
# ("1" behind Caddy/nginx/a load balancer) or their addresses. false when
# clients connect directly (local development). See docs/DEPLOYMENT.md.
TRUST_PROXY=false
# The interactive API reference at /docs (default: on outside production)
# API_DOCS=false
# Pages with sample data rather than real measurements: deployed
# applications, API gateway settings, backup/encryption switches, the
# platform's "coming soon" pages (default: on outside production)
# PREVIEW_FEATURES=false

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Rate Limiting: requests per IP per window, counted per server. Limits on
# sign-in attempts and codes are fixed and counted across servers.
RATE_LIMIT_MAX=1000
RATE_LIMIT_TIME_WINDOW=60000

# Logging
LOG_LEVEL=info

# Multi-tenancy Configuration
# Isolation mode for new tenants when the platform admin doesn't pick one
DEFAULT_TENANT_STRATEGY=SHARED_TABLES
TENANT_HEADER=x-tenant-id

# BFF Configuration
BFF_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
COOKIE_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
# BFF_URL is also where identity providers send people back after single
# sign-on: register BFF_URL/bff/auth/sso/callback with each provider.

# Platform users' sessions (tenants set theirs on the Authentication page)
PLATFORM_SESSION_IDLE_MINUTES=30
PLATFORM_SESSION_MAX_HOURS=12
# Make every platform user set up an authenticator app
PLATFORM_MFA_REQUIRED=false

# Audit log (docs/AUDIT_LOG.md). Entries are signed with this key (32 random
# bytes, base64; required in production). Keep it out of the database and
# never remove an old version while entries signed with it remain.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUDIT_KEY_V1=
# Entries older than this move to gzipped files in AUDIT_ARCHIVE_DIR
AUDIT_RETENTION_DAYS=365
AUDIT_ARCHIVE_DIR=./audit-archive
# How often to archive (ms); 0 = only with npm run audit:archive
AUDIT_ARCHIVE_INTERVAL_MS=86400000

# Support sessions (docs/PLATFORM_ACCESS.md): the longest a session may last,
# and whether someone with support:manage may approve their own request
# (only for one-person teams)
SUPPORT_MAX_HOURS=8
SUPPORT_SELF_APPROVAL=false

# Notifications (docs/NOTIFICATIONS.md). Emails use the email settings below.
# How often to look for due work: retries, and work a stopped server left (ms; 0 = never)
NOTIFICATION_POLL_MS=15000
# In-app notifications older than this are removed
NOTIFICATION_RETENTION_DAYS=90

# Dev only: return OTP codes in API responses (ignored unless NODE_ENV=development)
DEV_EXPOSE_OTP=true

# Email (one-time codes, invitations, password resets)
# smtp = real delivery (set SMTP_URL); log = print to the server log (local dev); file = append to MAIL_OUTBOX_FILE (tests)
EMAIL_TRANSPORT=log
# SMTP_URL=smtps://USERNAME:PASSWORD@smtp.example.com:465
MAIL_FROM="Multitenant Platform <no-reply@example.com>"
# Links in emails use FRONTEND_URL (set above), or a tenant's verified custom domain

# Self-service sign-up: anyone can create an organization from the sign-in
# page (after confirming their email). false = only platform staff create tenants.
SELF_SIGNUP=true
# The plan an organization that signs up starts on (as a trial)
SIGNUP_PLAN=FREE
# A bot check on the sign-up form (Cloudflare Turnstile, free): set both keys
# from the Cloudflare dashboard, or neither
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Refuse throwaway email addresses at sign-up (a built-in list), plus these domains
SIGNUP_BLOCK_DISPOSABLE=true
# SIGNUP_BLOCKED_EMAIL_DOMAINS=example.com,example.org

# Trials: how long a new one lasts (0 = no end) and how many days before the
# end its admins are reminded. An ended trial is read-only until platform staff
# change its status or end date.
TRIAL_DAYS=14
TRIAL_REMINDER_DAYS=3
# An organization its own admins close is deleted this many days later
# (platform staff can restore it until then)
CLOSE_GRACE_DAYS=30
# Organizations' data exports: where the files go (shared storage with several
# API servers) and how many days each can be downloaded
EXPORT_DIR=./exports
EXPORT_RETENTION_DAYS=7
# How often trials, closures, old sign-up requests and exports are checked (ms; 0 = never)
TENANT_LIFECYCLE_INTERVAL_MS=3600000

# Custom domains: tenants can use their own address (docs/DEPLOYMENT.md)
CUSTOM_DOMAINS=true
# The hostname tenants point their domain at (CNAME). Default: FRONTEND_URL's host
# CUSTOM_DOMAIN_TARGET=app.example.com
# DNS servers for checking tenants' TXT records (comma-separated, host or host:port).
# Default: the system's resolvers
# DNS_SERVERS=1.1.1.1,8.8.8.8
# How often verified domains are checked again (hours; 0 = never)
DOMAIN_RECHECK_HOURS=24

# Encryption key for stored secrets (tenant connection strings, SSO client
# secrets). Required in production: 32 random bytes, base64. Generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# To rotate: add SECRETS_KEY_V2 (newest version encrypts), run
# `npm run secrets:encrypt`, then remove V1 once `npm run secrets:encrypt -- --check` passes.
# Losing every key makes stored secrets unreadable: keep it in a secrets manager with a backup.
SECRETS_KEY_V1=
