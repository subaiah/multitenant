# Database Configuration
# Prisma 7 uses adapters instead of direct URL in schema
# This URL is used by prisma.config.ts for migrations
# and by the pg adapter for runtime connections
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/multitenant?schema=public"

# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_MAX=1000
RATE_LIMIT_TIME_WINDOW=60000

# Logging
LOG_LEVEL=info

# Multi-tenancy Configuration
DEFAULT_TENANT_STRATEGY=SHARED_TABLES
TENANT_HEADER=x-tenant-id

# BFF Configuration
BFF_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
COOKIE_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Dev only: return OTP codes in API responses (ignored unless NODE_ENV=development)
DEV_EXPOSE_OTP=true
