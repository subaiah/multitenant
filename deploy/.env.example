# Settings for deploy/docker-compose.yml. Copy to deploy/.env and fill in
# every empty value; compose refuses to start while one is missing.
# Keep .env out of version control: it holds every secret of the installation.
# (Comments go on their own lines: text after a value becomes part of it.)
#
# Generate each password (URL-safe, they go into connection strings):
#   openssl rand -hex 24
# Generate each key (32 random bytes, base64):
#   openssl rand -base64 32

# ---- where people reach it
# The public address, without a trailing slash
PUBLIC_URL=https://app.example.com
# The domain alone: Caddy gets an HTTPS certificate for it on its own (point
# the domain at this server and open ports 80 and 443). ":80" serves plain
# HTTP instead (a local trial, or behind another proxy that does HTTPS).
SITE_ADDRESS=app.example.com

# ---- database passwords
# Used by the database container's first start to create the roles; changing
# one later needs ALTER ROLE as well.
# The superuser, for maintenance only
POSTGRES_PASSWORD=
# The platform's own database (control plane)
CONTROL_DB_PASSWORD=
# Owns the tenant tables and runs tenant migrations
TENANT_OWNER_PASSWORD=
# Creates tenant roles and databases
TENANT_PROVISIONER_PASSWORD=
# Cross-tenant platform work
TENANT_PLATFORM_PASSWORD=

# ---- keys
# Keep a copy in a password manager or secrets manager: losing SECRETS_KEY
# makes stored secrets unreadable, losing AUDIT_KEY makes the audit log
# unverifiable.
JWT_SECRET=
COOKIE_SECRET=
SECRETS_KEY_V1=
AUDIT_KEY_V1=

# ---- email (invitations, password resets, sign-in codes, notifications)
SMTP_URL=smtps://USERNAME:PASSWORD@smtp.example.com:465
# A sending domain with SPF, DKIM and DMARC set up
MAIL_FROM="Your Platform <no-reply@example.com>"

# ---- optional (defaults shown)
# The product's name, shown in the platform portal and the browser tab
# APP_NAME=Multitenant
# Every platform user must use an authenticator app
# PLATFORM_MFA_REQUIRED=true
# Whether someone with support:manage may approve their own support session
# SUPPORT_SELF_APPROVAL=false
# Isolation mode for new tenants when none is chosen
# DEFAULT_TENANT_STRATEGY=SHARED_TABLES
# Anyone can create an organization from the sign-in page; false = platform staff only
# SELF_SIGNUP=true
# The plan an organization that signs up starts on (as a trial)
# SIGNUP_PLAN=FREE
# Tenants' own domains (docs/DEPLOYMENT.md, Custom domains)
# CUSTOM_DOMAINS=true
# What tenants point their domain at (CNAME); default: PUBLIC_URL's host
# CUSTOM_DOMAIN_TARGET=app.example.com
# Pages with sample data (deployed applications, API gateway settings)
# PREVIEW_FEATURES=false
# The interactive API reference at /api/docs
# API_DOCS=false
# Proxies in front of the API: 1 = Caddy only. Add one for each proxy in
# front of Caddy (a CDN or load balancer); see docs/DEPLOYMENT.md
# TRUST_PROXY=1
# POSTGRES_MAX_CONNECTIONS=300
# HTTP_PORT=80
# HTTPS_PORT=443
# Prebuilt images instead of building here (e.g. from your registry)
# API_IMAGE=ghcr.io/you/multitenant-api:1.0.0
# WEB_IMAGE=ghcr.io/you/multitenant-web:1.0.0
